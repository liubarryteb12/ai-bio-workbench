#!/data/data/com.termux/files/usr/bin/sh
set -eu
exec 2>&1
# ops/k40/sv/ssh-agent/run —— K40 Termux 宿主面 ssh-agent 服务定义（四段式模板，2026-11-03 起）
# 落点：k40:$PREFIX/var/service/<service>/{run,log/run}
# 同步：bash ops/k40/ensure_runsvdir.sh 会把本目录镜像到设备并幂等点火。
#
# 用法：Run `sv-enable ssh-agent` 并在 shell 配置里
#   export SSH_AUTH_SOCK="$PREFIX"/var/run/ssh-agent.socket
# 之后 ssh-add 加钥即可跨会话复用。
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
export PREFIX

service_agent() {
  # 设备重启或 Termux 被强停后 socket 残留会让 ssh-agent 起不来
  if [ -S "$1" ]; then
    unlink "$1"
  fi
  exec ssh-agent -D -a "$1"
}

if [ -r "${TERMUX__PREFIX:-${PREFIX}}"/etc/ssh/start_agent.sh ]; then
  . "${TERMUX__PREFIX:-${PREFIX}}"/etc/ssh/start_agent.sh
fi

export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-${TERMUX__PREFIX:-${PREFIX}}/var/run}"/ssh-agent.socket

service_agent "${SSH_AUTH_SOCK}"
