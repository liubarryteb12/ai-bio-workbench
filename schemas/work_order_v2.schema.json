{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioanalys.local/schemas/work_order_v2.schema.json",
  "title": "结构化工单（work_order/v2）",
  "description": "产品化正式工单的声明面。运行时校验真源是 shared/work_order_v2.mjs，CLI 与服务端共用。requirement 内部字段由 shared/requirement_schema.json 约束，本文件只固定 v2 外壳与安全边界。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "work_order_id",
    "project_id",
    "source_package",
    "requirement",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "const": "work_order/v2"
    },
    "work_order_id": {
      "$ref": "#/$defs/safeName"
    },
    "project_id": {
      "$ref": "#/$defs/safeName"
    },
    "source_package": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "package_dir",
        "requirement_path",
        "manifest_path"
      ],
      "properties": {
        "package_dir": {
          "$ref": "#/$defs/relativePath"
        },
        "requirement_path": {
          "$ref": "#/$defs/relativePath"
        },
        "manifest_path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "requirement_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "basicInfo",
        "dataSource",
        "groupingDesign"
      ],
      "properties": {
        "basicInfo": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "dataSource": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "source",
            "dataType",
            "datasets"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "dataType": {
              "type": "string",
              "minLength": 1
            },
            "datasets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "groupingDesign": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "mode",
            "groups",
            "contrasts"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "minLength": 1
            },
            "groups": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "groupName",
                  "role",
                  "sampleIds"
                ],
                "properties": {
                  "groupName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "enum": [
                      "reference",
                      "disease_stage"
                    ]
                  },
                  "sampleIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "contrasts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "name",
                  "case",
                  "ctrl",
                  "isPrimary"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "case": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ctrl": {
                    "type": "string",
                    "minLength": 1
                  },
                  "isPrimary": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "analysisCutoffs": {
          "type": "object",
          "additionalProperties": true
        },
        "biologicalPriors": {
          "type": "object",
          "additionalProperties": true
        },
        "figure_templates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "template_id"
            ],
            "properties": {
              "template_id": {
                "type": "string",
                "minLength": 1
              },
              "adapt_vars": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "role",
          "path",
          "filename",
          "size",
          "sha256"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\/]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "format": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "line_id",
        "mod_ids"
      ],
      "properties": {
        "line_id": {
          "enum": [
            "line1_bulk",
            "line2_scrna",
            "line3_spatial"
          ]
        },
        "mod_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "figure_selections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "template_id"
            ],
            "properties": {
              "template_id": {
                "type": "string",
                "minLength": 1
              },
              "adapt_vars": {
                "type": "object"
              }
            }
          }
        },
        "seed": {
          "type": "integer",
          "minimum": 1
        },
        "compute_adapter": {
          "enum": [
            "adb",
            "mock"
          ]
        },
        "species_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": []
    },
    "delivery": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "report_md": {
          "$ref": "#/$defs/relativePath"
        },
        "report_html": {
          "$ref": "#/$defs/relativePath"
        },
        "delivery_tar_pattern": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "require_admin_review": {
          "type": "boolean",
          "default": true
        },
        "resume": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "resume_since": {
          "type": [
            "string",
            "boolean",
            "null"
          ]
        },
        "force_report_build": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "create_payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "safeName": {
      "type": "string",
      "pattern": "^(?!\\.)[A-Za-z0-9._-]{1,64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!^[A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
