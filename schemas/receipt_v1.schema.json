{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioanalys.local/schemas/receipt_v1.schema.json",
  "title": "统一作业回执（receipt/v1）",
  "description": "权威回执落在 workspace/projects/<project_id>/report/receipt.v1.json，旧 work_order.receipt.json 只作为成功投影。本文件固定顶层字段、五态枚举、产物相对路径与交付引用形态。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "receipt_id",
    "work_order_digest",
    "work_order_id",
    "project_id",
    "line_id",
    "status",
    "started_at",
    "finished_at",
    "stages",
    "producer"
  ],
  "properties": {
    "schema_version": {
      "const": "receipt/v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "work_order_digest": {
      "$ref": "#/$defs/sha256"
    },
    "work_order_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "$ref": "#/$defs/safeName"
    },
    "line_id": {
      "enum": [
        "line1_bulk",
        "line2_scrna",
        "line3_spatial"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "blocked"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "failure_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "compute_adapter": {
      "type": [
        "string",
        "null"
      ]
    },
    "dag": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked"
            ]
          }
        }
      }
    },
    "upload_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "task_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "acceptance": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "delivery": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "required": [
        "tar_sha256",
        "verified_count",
        "coverage_ok",
        "verifier_version"
      ],
      "properties": {
        "receipt_path": {
          "$ref": "#/$defs/relativePath"
        },
        "tar_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "verified_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "coverage_ok": {
          "type": "boolean"
        },
        "verifier_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "path",
          "role",
          "stage"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "stage": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      }
    },
    "sentinel": {
      "type": [
        "string",
        "null"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "delivery"
        ],
        "properties": {
          "delivery": {
            "type": "object"
          },
          "sentinel": {
            "const": "PRODUCTIZATION_RECEIPT_OK"
          }
        }
      }
    }
  ],
  "$defs": {
    "safeName": {
      "type": "string",
      "pattern": "^(?!\\.)[A-Za-z0-9._-]{1,64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!^[A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
