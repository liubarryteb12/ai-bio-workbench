# Copy to .env.a2a locally. Never commit the real file.
CODEX_WORKSPACE_ROOT=.
A2A_HOST=127.0.0.1
A2A_PORT=8000
PI_TAILSCALE_IP=100.x.y.z
PI_A2A_PORT=9910
PI_A2A_ENDPOINT=http://100.x.y.z:9910
# Generate with: python -c "import secrets; print('a2a_sec_' + secrets.token_hex(24))"
A2A_CLIENT_BEARER_TOKEN=<REDACTED>
NO_PROXY=127.0.0.1,localhost,100.64.0.0/10
