#!/usr/bin/env bash
# external_validation：line1_bulk 独立外部数据集冻结验证。
#
# 接口：
#   --input external_frozen_model.tsv（ml_model 产物）
#   --input val_expr_genes.tsv（独立验证集基因表达矩阵）
#   --input val_group_map.tsv（独立验证集样本分组）
#
# 硬约束：
#   1. 验证集只使用训练阶段冻结的特征顺序、标准化参数、系数与截距。
#   2. 不在验证集重新筛基因、重新标准化、重新调参或重新拟合模型。
#   3. 不合并训练集与验证集表达值，不做跨平台 ComBat 后评估。
#   4. 验证平台缺失的冻结基因用训练集均值补缺，标准化后等价于 0，
#      并在报告与逐基因表中显式记录，不静默删特征。
#
# 退出码：0 成功，1 自校验失败，2 参数或输入契约错误，3 seed 缺失。
set -euo pipefail

seed="${BIOANALYS_SEED:-UNSET}"
if [ "$seed" = "UNSET" ]; then
  echo "BIOANALYS_SEED 未注入（引擎契约：seed 必须注入）" >&2
  exit 3
fi

declare -a INPUTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --input) INPUTS+=("$2"); shift 2 ;;
    --output) shift 2 ;;
    --seed) shift 2 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
done

model_file=""; val_expr_file=""; val_group_file=""
for path in "${INPUTS[@]:-}"; do
  [ -n "$path" ] || continue
  case "$path" in
    *external_frozen_model.tsv) model_file="$path" ;;
    *val_expr_genes.tsv) val_expr_file="$path" ;;
    *val_group_map.tsv) val_group_file="$path" ;;
    *) echo "无法识别的输入: $path" >&2; exit 2 ;;
  esac
done
[ -n "$model_file" ] && [ -f "$model_file" ] || { echo "缺 external_frozen_model.tsv" >&2; exit 2; }
[ -n "$val_expr_file" ] && [ -f "$val_expr_file" ] || { echo "缺 val_expr_genes.tsv" >&2; exit 2; }
[ -n "$val_group_file" ] && [ -f "$val_group_file" ] || { echo "缺 val_group_map.tsv" >&2; exit 2; }

echo "step_executed=external_validation"
echo "bioanalys_seed=${seed}"

MODEL_FILE="$model_file" VAL_EXPR_FILE="$val_expr_file" VAL_GROUP_FILE="$val_group_file" \
BIOANALYS_SEED="$seed" python3 - <<'PYSCRIPT'
import json
import os
import sys
import time

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from sklearn.metrics import (
    accuracy_score,
    balanced_accuracy_score,
    brier_score_loss,
    confusion_matrix,
    log_loss,
    roc_auc_score,
    roc_curve,
)

plt.rcParams.update({
    "figure.dpi": 300,
    "savefig.dpi": 300,
    "font.size": 9,
    "axes.titlesize": 10,
    "axes.grid": False,
    "figure.autolayout": True,
    "savefig.bbox": "tight",
})

START = time.time()
SEED = int(os.environ["BIOANALYS_SEED"])


def fail(message):
    sys.stderr.write("external_validation 自校验失败: %s\n" % message)
    sys.stderr.flush()
    sys.exit(1)


def log(message):
    print(message, flush=True)


def project_datasets():
    path = os.environ.get("BIOANALYS_PROJECT_JSON", "")
    if not path or not os.path.exists(path):
        return {}, {}
    try:
        with open(path, encoding="utf-8") as handle:
            project = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return {}, {}
    datasets = project.get("data_source", {}).get("datasets", [])
    train = next((item for item in datasets if item.get("role") == "train"), {})
    validation = next((item for item in datasets if item.get("role") == "validation"), {})
    return train, validation


def parse_frozen_model(path):
    table = pd.read_csv(path, sep="\t", dtype=str, keep_default_na=False)
    required = {"record_type", "feature_index", "gene", "value_key", "value"}
    if not required.issubset(table.columns):
        fail("冻结模型缺字段: %s" % sorted(required - set(table.columns)))
    model_rows = table[table["record_type"] == "model"]
    feature_rows = table[table["record_type"] == "feature"].copy()
    metadata = dict(zip(model_rows["value_key"], model_rows["value"]))
    required_meta = {
        "model_type", "penalty", "C", "max_iter", "seed", "case_group",
        "control_group", "train_dataset", "train_platform", "train_samples",
        "feature_count", "missing_value_strategy", "decision_threshold", "intercept",
    }
    if not required_meta.issubset(metadata):
        fail("冻结模型缺元信息: %s" % sorted(required_meta - set(metadata)))
    if metadata["model_type"] != "logistic_regression":
        fail("不支持的冻结模型: %s" % metadata["model_type"])
    if metadata["missing_value_strategy"] != "train_mean":
        fail("不支持的缺失基因策略: %s" % metadata["missing_value_strategy"])
    if int(metadata["seed"]) != SEED:
        fail("冻结模型 seed=%s 与当前 seed=%s 不一致" % (metadata["seed"], SEED))

    feature_rows["feature_index"] = pd.to_numeric(feature_rows["feature_index"], errors="coerce")
    if feature_rows["feature_index"].isna().any():
        fail("冻结特征索引含非数值")
    feature_rows = feature_rows.sort_values("feature_index")
    expected_index = list(range(len(feature_rows)))
    if feature_rows["feature_index"].astype(int).tolist() != expected_index:
        fail("冻结特征索引不连续")
    if int(metadata["feature_count"]) != len(feature_rows):
        fail("冻结特征数与 feature_count 不一致")

    parameters = []
    for row in feature_rows.itertuples(index=False):
        parts = {}
        for item in str(row.value).split(";"):
            if "=" not in item:
                fail("冻结特征参数格式错误: %s" % row.gene)
            key, value = item.split("=", 1)
            parts[key] = float(value)
        for key in ("scaler_mean", "scaler_scale", "coef"):
            if key not in parts or not np.isfinite(parts[key]):
                fail("冻结特征 %s 缺合法参数 %s" % (row.gene, key))
        if parts["scaler_scale"] <= 0:
            fail("冻结特征 %s 的 scaler_scale <= 0" % row.gene)
        parameters.append({
            "gene": str(row.gene),
            "scaler_mean": parts["scaler_mean"],
            "scaler_scale": parts["scaler_scale"],
            "coef": parts["coef"],
        })
    return metadata, pd.DataFrame(parameters)


train_meta, validation_meta = project_datasets()
metadata, frozen = parse_frozen_model(os.environ["MODEL_FILE"])
features = frozen["gene"].tolist()
if len(features) < 3 or len(set(features)) != len(features):
    fail("冻结特征少于 3 个或存在重复")

expr = pd.read_csv(os.environ["VAL_EXPR_FILE"], sep="\t", index_col=0)
group_map = pd.read_csv(os.environ["VAL_GROUP_FILE"], sep="\t")
for column in ("sample", "group"):
    if column not in group_map.columns:
        fail("val_group_map.tsv 缺列 %s" % column)
samples = [sample for sample in group_map["sample"].astype(str) if sample in expr.columns]
if len(samples) < 8:
    fail("验证集可用样本 %d < 8" % len(samples))
groups = group_map.set_index("sample").loc[samples, "group"].astype(str)
levels = sorted(groups.unique())
case_group = metadata["case_group"]
control_group = metadata["control_group"]
if case_group not in levels or control_group not in levels:
    fail("验证集分组 %s 不包含冻结模型的 case/control: %s/%s"
         % (levels, case_group, control_group))
y_true = np.array([1 if group == case_group else 0 for group in groups], dtype=int)
if y_true.sum() == 0 or (1 - y_true).sum() == 0:
    fail("验证集只有单一类别")

feature_values = []
missing_features = []
for row in frozen.itertuples(index=False):
    if row.gene in expr.index:
        values = expr.loc[row.gene, samples].to_numpy(dtype=float)
        if not np.all(np.isfinite(values)):
            fail("验证集基因 %s 含非有限值" % row.gene)
    else:
        values = np.full(len(samples), row.scaler_mean, dtype=float)
        missing_features.append(row.gene)
    feature_values.append(values)

X = np.column_stack(feature_values)
means = frozen["scaler_mean"].to_numpy(dtype=float)
scales = frozen["scaler_scale"].to_numpy(dtype=float)
coefs = frozen["coef"].to_numpy(dtype=float)
intercept = float(metadata["intercept"])
threshold = float(metadata["decision_threshold"])
if X.shape != (len(samples), len(features)):
    fail("验证矩阵维度错误: %s" % (X.shape,))
Z = (X - means) / scales
if not np.all(np.isfinite(Z)):
    fail("标准化后验证矩阵含非有限值")
linear = Z @ coefs + intercept
prob_case = 1.0 / (1.0 + np.exp(-linear))
pred = (prob_case >= threshold).astype(int)

auc = float(roc_auc_score(y_true, prob_case))
accuracy = float(accuracy_score(y_true, pred))
balanced_accuracy = float(balanced_accuracy_score(y_true, pred))
cm = confusion_matrix(y_true, pred, labels=[0, 1])
tn, fp, fn, tp = [int(value) for value in cm.ravel()]
sensitivity = float(tp / (tp + fn)) if (tp + fn) else float("nan")
specificity = float(tn / (tn + fp)) if (tn + fp) else float("nan")
brier = float(brier_score_loss(y_true, prob_case))
logloss = float(log_loss(y_true, prob_case, labels=[0, 1]))
if not (0.0 <= auc <= 1.0) or not np.isfinite([accuracy, balanced_accuracy, brier, logloss]).all():
    fail("外部验证指标含非有限值或 AUC 越界")

train_dataset = metadata["train_dataset"]
train_platform = metadata["train_platform"]
validation_dataset = str(validation_meta.get("gse", "unknown"))
validation_platform = str(validation_meta.get("gpl", "unknown"))
if train_dataset != "unknown" and str(train_meta.get("gse", "unknown")) != train_dataset:
    fail("冻结模型训练集与 project.json 不一致")
if validation_dataset != "unknown" and validation_platform != "unknown":
    log("external validation: %s/%s -> %s/%s"
        % (train_dataset, train_platform, validation_dataset, validation_platform))

pred_rows = []
for index, sample in enumerate(samples):
    pred_rows.append({
        "sample": sample,
        "true": int(y_true[index]),
        "pred": int(pred[index]),
        "prob_case": round(float(prob_case[index]), 6),
    })
pd.DataFrame(pred_rows).to_csv("external_validation_preds.tsv", sep="\t", index=False)

coef_rows = []
for index, row in frozen.iterrows():
    coef_rows.append({
        "feature_index": index,
        "gene": row["gene"],
        "frozen_scaler_mean": round(float(row["scaler_mean"]), 8),
        "frozen_scaler_scale": round(float(row["scaler_scale"]), 8),
        "frozen_coef": round(float(row["coef"]), 8),
        "direction": "up_in_case" if row["coef"] > 0 else "down_in_case",
        "present_in_validation": row["gene"] not in missing_features,
        "imputed_with_train_mean": row["gene"] in missing_features,
    })
pd.DataFrame(coef_rows).to_csv("external_frozen_coefs.tsv", sep="\t", index=False)

metrics = [
    ("validation_dataset", validation_dataset),
    ("validation_platform", validation_platform),
    ("n_validation", len(samples)),
    ("n_case", int(y_true.sum())),
    ("n_control", int((1 - y_true).sum())),
    ("frozen_features", len(features)),
    ("present_features", len(features) - len(missing_features)),
    ("gene_coverage", "%.6f" % ((len(features) - len(missing_features)) / len(features))),
    ("auc", "%.6f" % auc),
    ("accuracy", "%.6f" % accuracy),
    ("balanced_accuracy", "%.6f" % balanced_accuracy),
    ("sensitivity", "%.6f" % sensitivity),
    ("specificity", "%.6f" % specificity),
    ("brier_score", "%.6f" % brier),
    ("log_loss", "%.6f" % logloss),
    ("tn", tn),
    ("fp", fp),
    ("fn", fn),
    ("tp", tp),
    ("threshold", "%.6f" % threshold),
]
pd.DataFrame(metrics, columns=["metric", "value"]).to_csv(
    "external_validation_metrics.tsv", sep="\t", index=False)

fig, ax = plt.subplots(figsize=(6.5, 6))
fpr, tpr, _ = roc_curve(y_true, prob_case)
ax.plot(fpr, tpr, color="#C44E52", label="frozen LR (AUC=%.3f)" % auc)
ax.plot([0, 1], [0, 1], "k--", lw=0.8)
ax.set_xlabel("False positive rate")
ax.set_ylabel("True positive rate")
fig.text(0.01, -0.02,
         "line1: independent external validation\n%s/%s -> %s/%s, n=%d"
         % (train_dataset, train_platform, validation_dataset, validation_platform, len(samples)),
         ha="left", va="top", fontsize=8, linespacing=1.5)
ax.legend(loc="upper center", bbox_to_anchor=(0.5, -0.10), frameon=False)
fig.savefig("../figures/l1_12_external_roc.png")
plt.close(fig)

report = [
    "step=external_validation",
    "seed=%d" % SEED,
    "validation_type=independent_external_dataset",
    "train_dataset=%s" % train_dataset,
    "train_platform=%s" % train_platform,
    "validation_dataset=%s" % validation_dataset,
    "validation_platform=%s" % validation_platform,
    "merged_expression=false",
    "cross_platform_combat=false",
    "feature_reselection=false",
    "model_refit=false",
    "missing_value_strategy=train_mean",
    "frozen_model=external_frozen_model.tsv",
    "frozen_features=%d" % len(features),
    "present_features=%d" % (len(features) - len(missing_features)),
    "missing_features=%s" % ",".join(missing_features),
    "gene_coverage=%.3f" % ((len(features) - len(missing_features)) / len(features)),
    "n_validation=%d (%s=%d %s=%d)" % (
        len(samples), case_group, int(y_true.sum()), control_group, int((1 - y_true).sum())),
    "external_auc=%.3f" % auc,
    "external_accuracy=%.3f" % accuracy,
    "external_balanced_accuracy=%.3f" % balanced_accuracy,
    "external_sensitivity=%.3f" % sensitivity,
    "external_specificity=%.3f" % specificity,
    "external_brier_score=%.6f" % brier,
    "external_log_loss=%.6f" % logloss,
    "confusion_matrix(labels=0,1)=%s" % cm.tolist(),
    "limitation_note=训练与验证平台不同，存在表达分布漂移；缺失冻结基因按训练集均值补缺；",
    "              结果只代表该冻结模型在当前独立数据集上的真实表现，不用于反向调参",
    "outputs=external_validation_preds.tsv, external_frozen_coefs.tsv, external_validation_metrics.tsv, ../figures/l1_12_external_roc.png, external_validation_report.txt",
    "elapsed_seconds=%.1f" % (time.time() - START),
]
with open("external_validation_report.txt", "w", encoding="utf-8") as handle:
    handle.write("\n".join(report) + "\n")
log("external_validation_done")
PYSCRIPT
