#!/usr/bin/env bash
# ppi_string：line1_bulk 步骤 8 的 PPI / hub 基因部分（STRING API）。
#
# 输入（同 cwd）：wgcna_modules.tsv（gene/module）+ wgcna_module_trait.tsv
#   （module/significant）——取"与分组显著相关"的模块基因做 PPI。
#   DEG 0 显著（BH 后无基因通过），故 PPI 输入取 WGCNA 显著模块基因而非 DEG。
#
# 做法（用户 2026-10-13 拍板 PPI 在线富集可做）：
#   1. 显著模块基因（tan + plum1）经 STRING API（species=9606）拉互作边；
#   2. 计算 degree 得 hub 基因（top 30）；
#   3. 画 PPI 网络图（networkx spring layout，单图，只画 top 边避免糊成一团）；
#   4. 落边表 / hub 表 / 报告。
#
# 自校验内建：输入存在、显著模块非空、STRING 返回边数 > 0、hub 非空、
# degree 与边表一致。
set -euo pipefail

seed="${BIOANALYS_SEED:-UNSET}"
if [ "$seed" = "UNSET" ]; then
  echo "BIOANALYS_SEED 未注入（引擎契约：seed 必须注入）" >&2
  exit 3
fi

declare -a INPUTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --input) INPUTS+=("$2"); shift 2 ;;
    --output) shift 2 ;;
    --seed) shift 2 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
done

mod_file=""
trait_file=""
for path in "${INPUTS[@]:-}"; do
  [ -n "$path" ] || continue
  case "$path" in
    *wgcna_modules*.tsv) mod_file="$path" ;;
    *wgcna_module_trait*.tsv) trait_file="$path" ;;
    *) echo "无法识别的输入文件: $path（需要 wgcna_modules / wgcna_module_trait）" >&2; exit 2 ;;
  esac
done
if [ -z "$mod_file" ]; then
  echo "缺少必需输入：wgcna_modules.tsv" >&2
  exit 2
fi
# trait 文件缺省按同目录固定名找
if [ -z "$trait_file" ]; then
  guess="$(dirname "$mod_file")/wgcna_module_trait.tsv"
  [ -f "$guess" ] && trait_file="$guess"
fi
[ -f "$mod_file" ] || { echo "输入不存在: $mod_file" >&2; exit 2; }

echo "step_executed=ppi_string"
echo "bioanalys_seed=${seed}"
echo "input_modules=${mod_file}"
echo "input_trait=${trait_file}"

MOD_FILE="$mod_file" TRAIT_FILE="$trait_file" BIOANALYS_SEED="$seed" \
python3 - <<'PYSCRIPT'
import json
import os
import sys
import time
import urllib.parse
import urllib.request

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

plt.rcParams.update({"figure.dpi": 300, "savefig.dpi": 300, "font.size": 8,
                     "axes.titlesize": 9, "axes.grid": False,
                     "figure.autolayout": True, "savefig.bbox": "tight",
                     "image.cmap": "viridis"})


def caption(fig, *parts):
    """图注置于坐标轴框外：竖版图（宽<高）在右上角纵向多行；
    横版图（宽>=高）在图幅下方纵向多行（一条一行，不横向拼接）。"""
    parts = [str(p) for p in parts if p not in (None, "")]
    if not parts:
        return
    w, h = fig.get_size_inches()
    text = "\n".join(parts)
    if w >= h:
        fig.text(0.01, -0.02, text, ha="left", va="top", fontsize=8,
                 linespacing=1.5)
    else:
        fig.text(1.02, 1.0, text, ha="left", va="top", fontsize=8,
                 linespacing=1.5)


def wrap_label(text, width=18):
    """长标签换行：超宽标签优先按 _ 边界折行，仍超宽再按字符折行，防溢出图框。"""
    import textwrap

    s = str(text)
    if len(s) <= width:
        return s
    lines, cur = [], ""
    for part in s.split("_"):
        joined = part if not cur else cur + "_" + part
        if cur and len(joined) > width:
            lines.append(cur)
            cur = part
        else:
            cur = joined
    if cur:
        lines.append(cur)
    if max(len(x) for x in lines) <= width:
        return "\n".join(lines)
    out = []
    for line in lines:
        out.extend(textwrap.wrap(line, width=width) or [line])
    return "\n".join(out)


def fit_text_edges(fig, ax, gap=6.0, rounds=5):
    """把越出坐标轴框的轴内文本收进框内：右缘/顶缘/左缘/下缘越界时自动扩 xlim/ylim。
    实测像素宽度迭代收敛（至少留 6px 边距，比审计容差 3px 更严），柱顶数值标注与条形
    末端外挂标注都按同一规则留位；若扩一轮越界没有改善（文本框锚在轴坐标而非数据坐标）
    就停手，防无意义放大把主图压扁。"""
    prev = None
    for _ in range(rounds):
        fig.canvas.draw()
        rend = fig.canvas.get_renderer()
        bb = ax.get_window_extent()
        boxes = [t.get_window_extent(renderer=rend) for t in ax.texts
                 if t.get_text().strip()]
        if not boxes:
            return
        bw = max(bb.width, 1e-6)
        bh = max(bb.height, 1e-6)
        right = max(b.x1 for b in boxes) - bb.x1
        top = max(b.y1 for b in boxes) - bb.y1
        left = bb.x0 - min(b.x0 for b in boxes)
        bottom = bb.y0 - min(b.y0 for b in boxes)
        if max(right, top, left, bottom) <= gap:
            return
        worst = max(right / bw, top / bh, left / bw, bottom / bh)
        if prev is not None and worst >= prev * 0.98:
            return
        prev = worst
        x0, x1 = ax.get_xlim()
        y0, y1 = ax.get_ylim()
        if right > gap:
            ax.set_xlim(x0, x1 + (x1 - x0) * (right / bw) * 1.15)
            x0, x1 = ax.get_xlim()
        if left > gap:
            ax.set_xlim(x0 - (x1 - x0) * (left / bw) * 1.15, x1)
            x0, x1 = ax.get_xlim()
        if top > gap:
            ax.set_ylim(y0, y1 + (y1 - y0) * (top / bh) * 1.15)
            y0, y1 = ax.get_ylim()
        if bottom > gap:
            ax.set_ylim(y0 - (y1 - y0) * (bottom / bh) * 1.15, y1)


def legend_out(ax, fig, leg):
    """图例移到坐标轴框外：竖版图（宽<高）右上角纵向单列；横版图（宽>=高）下方纵向单列。
    条目超过 12 条按列分组，避免纵向过长压扁主图。"""
    n = len(leg.get_texts())
    handles = list(leg.legend_handles)
    labels = [t.get_text() for t in leg.get_texts()]
    title = leg.get_title().get_text() or None
    w, h = fig.get_size_inches()
    fig.set_layout_engine("none")
    if w >= h:
        ncol = 1 if n <= 12 else -(-n // 12)
        rows = -(-n // ncol)
        ax.legend(handles, labels, loc="upper center", bbox_to_anchor=(0.5, -0.10),
                  ncol=ncol, fontsize=8, frameon=False, title=title)
        fig.subplots_adjust(bottom=min(0.58, 0.16 + 0.045 * rows))
    else:
        ax.legend(handles, labels, loc="upper left", bbox_to_anchor=(1.02, 1.0),
                  ncol=1, fontsize=8, frameon=False, title=title)
        fig.subplots_adjust(right=0.74)


def layout_fix(fig):
    """落盘前统一收口（docs/figure_spec.md v2.2 §三之三）：
    1) 单坐标轴图的图例外置：竖版置轴框外右上角、横版置轴框下方，纵向排布、不压数据；
    2) 轴内文本右缘/顶缘/左缘/下缘越出坐标轴框时自动扩 xlim/ylim 收进框内。
    多子图（分面）图不做图例搬迁：分面各有自己的图例，统一外移会互相压扁。
    tick 标签一律不动：它本就在轴框外，savefig.bbox="tight" 会把画布扩到装下它；
    强行换行反而让多行标签在密集类目轴上互相压字（实测见踩坑台账）。"""
    from matplotlib.colorbar import Colorbar

    axes = [a for a in fig.get_axes() if not isinstance(a, Colorbar)]
    if not axes:
        return
    if len(axes) == 1:
        leg = axes[0].get_legend()
        if leg is not None:
            legend_out(axes[0], fig, leg)
        fit_text_edges(fig, axes[0])


def _install_layout_guard():
    """装一次全局收口：脚本内任何 fig.savefig 落盘前先走 layout_fix()，
    以后新增图自动套版式规则，不靠人记得调用（docs/figure_spec.md v2.2 §三之三）。"""
    from matplotlib.figure import Figure

    if getattr(Figure.savefig, "_layout_guard", False):
        return
    orig = Figure.savefig

    def guarded(self, fname, *a, **kw):
        layout_fix(self)
        return orig(self, fname, *a, **kw)

    guarded._layout_guard = True
    guarded._orig_savefig = orig
    Figure.savefig = guarded


_install_layout_guard()

START = time.time()
SEED = int(os.environ["BIOANALYS_SEED"])
SPECIES = 9606
MIN_SCORE = 400          # STRING combined score 阈值（中等置信）
MAX_HUB = 30
MAX_EDGES = 100          # 网络图边数上限（规范：大网络只画 top N，默认 100 边）


def fail(m):
    sys.stderr.write("ppi_string 自校验失败: %s\n" % m)
    sys.stderr.flush()
    sys.exit(1)


def log(m):
    print(m, flush=True)


mods = pd.read_csv(os.environ["MOD_FILE"], sep="\t")
trait_file = os.environ.get("TRAIT_FILE", "")
if not trait_file or not os.path.exists(trait_file):
    fail("缺 wgcna_module_trait.tsv（无法确定显著模块）")
trait = pd.read_csv(trait_file, sep="\t")
if "significant" not in trait.columns or "module" not in trait.columns:
    fail("wgcna_module_trait 缺 module/significant 列")
sig_modules = trait.loc[trait["significant"].astype(bool), "module"].astype(str).tolist()
if not sig_modules:
    fail("没有与分组显著相关的模块，PPI 无输入")
genes = sorted(set(mods.loc[mods["module"].astype(str).isin(sig_modules), "gene"].astype(str)))
log("significant modules=%s genes=%d" % (sig_modules, len(genes)))
if len(genes) < 3:
    fail("显著模块基因 < 3")

# --- STRING network API（POST，避免 URL 过长） ---
url = "https://string-db.org/api/tsv/network"
body = urllib.parse.urlencode({
    "identifiers": "\r".join(genes),
    "species": SPECIES,
    "required_score": MIN_SCORE,
}).encode()
req = urllib.request.Request(url, data=body,
                             headers={"User-Agent": "BioanalysDesktop/0.1"})
try:
    with urllib.request.urlopen(req, timeout=90) as resp:
        raw = resp.read().decode("utf-8")
except Exception as e:
    fail("STRING API 调用失败：%s" % e)

lines = [ln for ln in raw.splitlines() if ln.strip()]
if len(lines) < 2:
    fail("STRING 返回 %d 行（<2），无互作边（阈值 %d 可能过高）" % (len(lines), MIN_SCORE))
header = lines[0].split("\t")
rows = [dict(zip(header, ln.split("\t"))) for ln in lines[1:]]
edges = pd.DataFrame(rows)
log("STRING edges=%d" % len(edges))

# --- degree / hub ---
deg = {}
for _, r in edges.iterrows():
    a = r["preferredName_A"]
    b = r["preferredName_B"]
    deg[a] = deg.get(a, 0) + 1
    deg[b] = deg.get(b, 0) + 1
hub = pd.DataFrame({"gene": list(deg.keys()), "degree": list(deg.values())})
hub = hub.sort_values("degree", ascending=False).reset_index(drop=True)
hub.head(200).to_csv("ppi_hubs.tsv", sep="\t", index=False)
edges_out = edges[["preferredName_A", "preferredName_B", "score"]].copy()
edges_out.columns = ["gene_a", "gene_b", "combined_score"]
edges_out.to_csv("ppi_edges.tsv", sep="\t", index=False)
log("wrote ppi_edges.tsv (%d) + ppi_hubs.tsv (%d genes)" % (len(edges_out), len(hub)))

if len(hub) == 0:
    fail("hub 为空")

# --- 网络图（单图，只画 top 边） ---
try:
    import networkx as nx
    G = nx.Graph()
    for _, r in edges_out.iterrows():
        G.add_edge(r["gene_a"], r["gene_b"], weight=float(r["combined_score"]))
    # 只保留 top-N hub 的子图，避免节点过多糊成一团
    top_nodes = set(hub.head(MAX_HUB)["gene"].tolist())
    H = G.subgraph([n for n in G.nodes() if n in top_nodes]).copy()
    # 边数上限（规范：大网络只画 top N，默认 100 边），按 combined_score 降序截断
    if H.number_of_edges() > MAX_EDGES:
        e_sorted = sorted(H.edges(data=True),
                          key=lambda e: e[2].get("weight", 0.0), reverse=True)
        H = H.edge_subgraph([(a, b) for a, b, _ in e_sorted[:MAX_EDGES]]).copy()
        H.remove_nodes_from([n for n in list(H.nodes()) if H.degree(n) == 0])
    if H.number_of_nodes() >= 2:
        fig, ax = plt.subplots(figsize=(12, 10))
        pos = nx.spring_layout(H, seed=SEED, k=0.6)
        degs = dict(H.degree())
        sizes = [80 + 40 * degs.get(n, 0) for n in H.nodes()]
        # 边权映射：宽度 + 颜色（viridis），并附色条说明（规范：网络类须标注边权）
        ws = [e[2].get("weight", 0.0) for e in H.edges(data=True)]
        wmin, wmax = min(ws), max(ws)
        norm = [(w - wmin) / (wmax - wmin + 1e-9) for w in ws]
        nx.draw_networkx_edges(H, pos, ax=ax, alpha=0.35,
                               width=[0.4 + 1.6 * v for v in norm],
                               edge_color=norm, edge_cmap=plt.cm.viridis)
        nx.draw_networkx_nodes(H, pos, ax=ax, node_size=sizes,
                               node_color="#4C72B0", alpha=0.85)
        nx.draw_networkx_labels(H, pos, ax=ax, font_size=8)
        # 节点标签自动避让（规范 §三之二：图内文字不得互相重叠）。STRING API 每次重取
        # 会给出不同的边表，spring 布局随之变化，高连接度节点偶发挤在一起压字；
        # 引线保住"标签属于哪个节点"，避免纯位移后标签与节点脱钩。
        from adjustText import adjust_text
        adjust_text(ax.texts, ax=ax, expand=(1.4, 1.6),
                    arrowprops=dict(arrowstyle="-", color="0.75", lw=0.4))
        sm = plt.cm.ScalarMappable(cmap=plt.cm.viridis,
                                   norm=plt.Normalize(wmin, wmax))
        fig.colorbar(sm, ax=ax, shrink=0.5, label="STRING combined score")
        caption(fig, "line1: PPI network (significant WGCNA module genes)",
                "top %d hubs / top %d edges by combined score, STRING"
                % (MAX_HUB, MAX_EDGES))
        ax.axis("off")
        fig.savefig("../figures/l1_07_ppi_network.png")
        plt.close(fig)
        log("wrote ../figures/l1_07_ppi_network.png")
    else:
        log("子图节点 < 2，跳过网络图")
except ImportError:
    log("networkx 未装，跳过网络图")

# --- hub bar（单图） ---
fig, ax = plt.subplots(figsize=(9, 6))
top = hub.head(MAX_HUB).iloc[::-1]
ax.barh(range(len(top)), top["degree"].to_numpy(), color="#C44E52")
ax.set_yticks(range(len(top)))
ax.set_yticklabels(top["gene"].tolist(), fontsize=8)
ax.set_xlabel("degree (STRING interactions)")
caption(fig, "line1: PPI hub genes", "top %d by degree" % MAX_HUB)
fig.savefig("../figures/l1_08_ppi_hubs.png")
plt.close(fig)
log("wrote ../figures/l1_08_ppi_hubs.png")

# --- 报告 ---
lines = [
    "step=ppi_string",
    "seed=%d" % SEED,
    "input_modules=%s genes=%d (modules=%s)" % (os.environ["MOD_FILE"], len(genes), sig_modules),
    "method=STRING API network (species=%d, required_score=%d)" % (SPECIES, MIN_SCORE),
    "note=DEG 0 显著，PPI 输入取 WGCNA 与分组显著相关的模块基因；hub=degree top",
    "n_edges=%d n_genes_in_network=%d" % (len(edges_out), len(hub)),
    "top_hubs:",
]
for _, r in hub.head(15).iterrows():
    lines.append("  %-14s degree=%d" % (r["gene"], r["degree"]))
lines.append("outputs=ppi_edges.tsv, ppi_hubs.tsv, ../figures/l1_07_ppi_network.png, ../figures/l1_08_ppi_hubs.png, ppi_report.txt")
lines.append("elapsed_seconds=%.1f" % (time.time() - START))
with open("ppi_report.txt", "w", encoding="utf-8") as fh:
    fh.write("\n".join(lines) + "\n")
log("ppi_string_done")
PYSCRIPT
