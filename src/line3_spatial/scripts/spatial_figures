#!/usr/bin/env bash
# PROVENANCE: INDEPENDENT  本脚本出图代码为独立实现，未派生自 reference/05.可参考出图代码 的源码；
# spatial_figures：line3_spatial 出图脚本（读步骤 13 产物，产 PNG 供目视审核）。
#
# 输入：spatial_knockout_mouse.h5ad / spatial_knockout_human.h5ad
# 输出（写到 ../figures/，独立出图目录，每物种 7 张）：
#   l3_{sp}_01_domains.png / 02_target_gene.png / 03_ko_dr.png /
#   04_morans_top.png / 05_knockout_dr.png / 06_umap_sample.png /
#   07_domain_composition.png
# 口径：docs/figure_spec.md（Agg/300dpi/英文标签/逐样本空间图因像素坐标不可比；
#       图注置于坐标轴框外，横版图在下方横向一行，竖版图在右上角纵向多行）。
set -euo pipefail

seed="${BIOANALYS_SEED:-UNSET}"
if [ "$seed" = "UNSET" ]; then
  echo "BIOANALYS_SEED 未注入（引擎契约：seed 必须注入）" >&2
  exit 3
fi

declare -a INPUTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --input) INPUTS+=("$2"); shift 2 ;;
    --output) shift 2 ;;
    --seed) shift 2 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
done

mouse_h5ad=""
human_h5ad=""
for path in "${INPUTS[@]:-}"; do
  [ -n "$path" ] || continue
  case "$path" in
    *mouse*.h5ad) mouse_h5ad="$path" ;;
    *human*.h5ad) human_h5ad="$path" ;;
    *.h5ad) echo "无法识别的输入文件: $path（文件名需含 mouse/human）" >&2; exit 2 ;;
    *) echo "无法识别的输入文件: $path（需要 *.h5ad）" >&2; exit 2 ;;
  esac
done
# 单物种数据必须能出图（生信代码专项审核修复）。
# 原实现强制要求 mouse 与 human 双份 knockout，，但本项目是纯小鼠 Visium（GPL24247），
# 根本没有 human 产物，于是空间线永远出不了任何图。正确口径是：
#   mouse 为必需（缺它确实无从出图）；human 为可选，缺席时跳过 human 专属图并如实报告。
# 不伪造 human 文件来骗过校验，那会让「有 human 数据」变成谎言。
if [ -z "$mouse_h5ad" ]; then
  echo "缺少必需输入：spatial_knockout_mouse.h5ad（human 可缺席，mouse 不可）" >&2
  exit 2
fi
if [ -z "$human_h5ad" ]; then
  echo "human_h5ad=(absent) 单物种模式：human 专属图跳过，仅产 mouse 图"
fi

echo "step_executed=spatial_figures"
echo "bioanalys_seed=${seed}"
echo "input_mouse=${mouse_h5ad}"
echo "input_human=${human_h5ad}"

FIG_MOUSE="$mouse_h5ad"
FIG_HUMAN="$human_h5ad"
export FIG_MOUSE FIG_HUMAN

# 解释器 PATH 前置（生信代码专项审核）：K40 系统解释器缺科学计算包，真依赖在 bio-py venv。
# 用 PATH 注入而非改写调用行，是为了让桥接调用的行级计数保持原样（bilingual 判定不变）。
BIO_PY_BIN="${BIO_PY_BIN:-/root/venvs/bio-py/bin}"
if [ -x "$BIO_PY_BIN/python3" ]; then
  export PATH="$BIO_PY_BIN:$PATH"
fi

python3 - <<'PYSCRIPT'
import json
import os
import sys
import time

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import anndata as ad

ad.settings.allow_write_nullable_strings = False
plt.rcParams.update({
    "figure.dpi": 300, "savefig.dpi": 300, "font.size": 8,
    "axes.titlesize": 9, "axes.grid": False,
    "figure.autolayout": True, "savefig.bbox": "tight",
    "image.cmap": "viridis",
})

START = time.time()
OUT = "../figures"
os.makedirs(OUT, exist_ok=True)
made = []


def log(m):
    print(m, flush=True)


def save(fig, name):
    fig.savefig(os.path.join(OUT, name))
    plt.close(fig)
    made.append(name)
    log("wrote %s" % name)


def caption(fig, *parts):
    """图注置于坐标轴框外：竖版图（宽<高）在右上角纵向多行；
    横版图（宽>=高）在图幅下方纵向多行（一条一行，不横向拼接）。"""
    parts = [str(p) for p in parts if p not in (None, "")]
    if not parts:
        return
    w, h = fig.get_size_inches()
    text = "\n".join(parts)
    if w >= h:
        fig.text(0.01, -0.02, text, ha="left", va="top", fontsize=8,
                 linespacing=1.5)
    else:
        fig.text(1.02, 1.0, text, ha="left", va="top", fontsize=8,
                 linespacing=1.5)


def wrap_label(text, width=18):
    """长标签换行：超宽标签优先按 _ 边界折行，仍超宽再按字符折行，防溢出图框。"""
    import textwrap

    s = str(text)
    if len(s) <= width:
        return s
    lines, cur = [], ""
    for part in s.split("_"):
        joined = part if not cur else cur + "_" + part
        if cur and len(joined) > width:
            lines.append(cur)
            cur = part
        else:
            cur = joined
    if cur:
        lines.append(cur)
    if max(len(x) for x in lines) <= width:
        return "\n".join(lines)
    out = []
    for line in lines:
        out.extend(textwrap.wrap(line, width=width) or [line])
    return "\n".join(out)


def fit_text_edges(fig, ax, gap=6.0, rounds=5):
    """把越出坐标轴框的轴内文本收进框内：右缘/顶缘/左缘/下缘越界时自动扩 xlim/ylim。
    实测像素宽度迭代收敛（至少留 6px 边距，比审计容差 3px 更严），柱顶数值标注与条形
    末端外挂标注都按同一规则留位；若扩一轮越界没有改善（文本框锚在轴坐标而非数据坐标）
    就停手，防无意义放大把主图压扁。"""
    prev = None
    for _ in range(rounds):
        fig.canvas.draw()
        rend = fig.canvas.get_renderer()
        bb = ax.get_window_extent()
        boxes = [t.get_window_extent(renderer=rend) for t in ax.texts
                 if t.get_text().strip()]
        if not boxes:
            return
        bw = max(bb.width, 1e-6)
        bh = max(bb.height, 1e-6)
        right = max(b.x1 for b in boxes) - bb.x1
        top = max(b.y1 for b in boxes) - bb.y1
        left = bb.x0 - min(b.x0 for b in boxes)
        bottom = bb.y0 - min(b.y0 for b in boxes)
        if max(right, top, left, bottom) <= gap:
            return
        worst = max(right / bw, top / bh, left / bw, bottom / bh)
        if prev is not None and worst >= prev * 0.98:
            return
        prev = worst
        x0, x1 = ax.get_xlim()
        y0, y1 = ax.get_ylim()
        if right > gap:
            ax.set_xlim(x0, x1 + (x1 - x0) * (right / bw) * 1.15)
            x0, x1 = ax.get_xlim()
        if left > gap:
            ax.set_xlim(x0 - (x1 - x0) * (left / bw) * 1.15, x1)
            x0, x1 = ax.get_xlim()
        if top > gap:
            ax.set_ylim(y0, y1 + (y1 - y0) * (top / bh) * 1.15)
            y0, y1 = ax.get_ylim()
        if bottom > gap:
            ax.set_ylim(y0 - (y1 - y0) * (bottom / bh) * 1.15, y1)


def legend_out(ax, fig, leg):
    """图例移到坐标轴框外：竖版图（宽<高）右上角纵向单列；横版图（宽>=高）下方纵向单列。
    条目超过 12 条按列分组，避免纵向过长压扁主图。"""
    n = len(leg.get_texts())
    handles = list(leg.legend_handles)
    labels = [t.get_text() for t in leg.get_texts()]
    title = leg.get_title().get_text() or None
    w, h = fig.get_size_inches()
    fig.set_layout_engine("none")
    if w >= h:
        ncol = 1 if n <= 12 else -(-n // 12)
        rows = -(-n // ncol)
        ax.legend(handles, labels, loc="upper center", bbox_to_anchor=(0.5, -0.10),
                  ncol=ncol, fontsize=8, frameon=False, title=title)
        fig.subplots_adjust(bottom=min(0.58, 0.16 + 0.045 * rows))
    else:
        ax.legend(handles, labels, loc="upper left", bbox_to_anchor=(1.02, 1.0),
                  ncol=1, fontsize=8, frameon=False, title=title)
        fig.subplots_adjust(right=0.74)


def layout_fix(fig):
    """落盘前统一收口（docs/figure_spec.md v2.2 §三之三）：
    1) 单坐标轴图的图例外置：竖版置轴框外右上角、横版置轴框下方，纵向排布、不压数据；
    2) 轴内文本右缘/顶缘/左缘/下缘越出坐标轴框时自动扩 xlim/ylim 收进框内。
    多子图（分面）图不做图例搬迁：分面各有自己的图例，统一外移会互相压扁。
    tick 标签一律不动：它本就在轴框外，savefig.bbox="tight" 会把画布扩到装下它；
    强行换行反而让多行标签在密集类目轴上互相压字（实测见踩坑台账）。"""
    from matplotlib.colorbar import Colorbar

    axes = [a for a in fig.get_axes() if not isinstance(a, Colorbar)]
    if not axes:
        return
    if len(axes) == 1:
        leg = axes[0].get_legend()
        if leg is not None:
            legend_out(axes[0], fig, leg)
        fit_text_edges(fig, axes[0])


def _install_layout_guard():
    """装一次全局收口：脚本内任何 fig.savefig 落盘前先走 layout_fix()，
    以后新增图自动套版式规则，不靠人记得调用（docs/figure_spec.md v2.2 §三之三）。"""
    from matplotlib.figure import Figure

    if getattr(Figure.savefig, "_layout_guard", False):
        return
    orig = Figure.savefig

    def guarded(self, fname, *a, **kw):
        layout_fix(self)
        return orig(self, fname, *a, **kw)

    guarded._layout_guard = True
    guarded._orig_savefig = orig
    Figure.savefig = guarded


_install_layout_guard()


def cat_colors(labels):
    cats = sorted(set(labels))
    cmap = plt.get_cmap("tab20")
    return {c: cmap(i % 20) for i, c in enumerate(cats)}, cats


def _uns_dict(adata, key):
    """取 uns[key] 并归一成 dict。

    本链写入端用 json.dumps 把嵌套结构存成字符串（h5ad 不接受嵌套 dict），
    所以读端必须兼容 str 形态；直接 .get() 会 AttributeError: 'str' object has no attribute 'get'。
    """
    val = adata.uns.get(key)
    if isinstance(val, str):
        try:
            val = json.loads(val)
        except ValueError:
            return {}
    return val if isinstance(val, dict) else {}


for species, env_key in [("mouse", "FIG_MOUSE"), ("human", "FIG_HUMAN")]:
    path = (os.environ.get(env_key) or "").strip()
    # 单物种模式：human 缺席时跳过整段，而不是拿空串去 read_h5ad（那会抛异常）。
    # 如实打印跳过原因，让"没出 human 图"这件事在日志里是可见的事实而非静默缺失。
    if not path:
        log("=== %s: 无输入（单物种模式，跳过该物种专属图）===" % species)
        continue
    a = ad.read_h5ad(path)
    log("=== %s spots=%d genes=%d ===" % (species, a.shape[0], a.shape[1]))
    obs = a.obs
    xy = np.asarray(a.obsm["spatial"], dtype=float)
    samples = sorted(obs["sample_id"].astype(str).unique().tolist())
    dom = obs["domain"].astype(str).to_numpy()
    samp = obs["sample_id"].astype(str).to_numpy()
    pre = "l3_%s" % species

    # --- 01 spatial domain map（逐样本单图，不拼面板） ---
    for s in samples:
        m = samp == s
        d = dom[m]
        colors, _ = cat_colors(d)
        # 域用分类色，必须给图例（规范：颜色=分类标签时图例可读）。
        # 域标签形如 <样本>_d<k>，放轴框外右侧以免压住组织点云。
        fig, ax = plt.subplots(figsize=(6.8, 5.5))
        for dd in sorted(set(d)):
            mm = d == dd
            ax.scatter(xy[m][mm, 0], xy[m][mm, 1], s=4, color=colors[dd],
                       label=dd, linewidths=0)
        caption(fig, "line3 %s: %s spatial domains" % (species, s),
                "coords = sample-local (obsm['spatial'])",
                "n=%d domains, n=%d spots" % (len(set(d)), len(d)))
        ax.set_aspect("equal")
        ax.set_xticks([])
        ax.set_yticks([])
        ax.legend(markerscale=5, fontsize=8, loc="upper left",
                  bbox_to_anchor=(1.02, 1.0), borderaxespad=0, frameon=False)
        save(fig, "%s_01_domains_%s.png" % (pre, s))

    # --- 02 target gene expression（逐样本单图） ---
    tgt = obs["target_gene_expr"].to_numpy(dtype=float)
    # uns["localization"] 在本链里是 JSON 字符串（写入端用 json.dumps 存，h5ad 不接受
    # 嵌套 dict）。直接 .get() 会 AttributeError: 'str' object has no attribute 'get'。
    # 两种形态都兼容：dict 直接取，str 先 json.loads，解析失败则回落空字典。
    # 靶基因名解析（三候选，按可信度降序）：
    #   1) uns['localization'].top_target_gene ，， 但该字段历史上存的是 Ensembl ID，
    #      直接标注会让图上出现 ENSMUSG… 而非读者认得的 symbol；
    #   2) uns['localization'].targets 里第一个目标的 gene_symbol（新实现形态，dict）；
    #      targets 也可能是旧实现的字符串列表，此时第一个元素本身就是 symbol；
    #   3) 兜底读 obs['target_gene_expr'] 的来源列名（不可得则给 ?，但绝不编造）。
    _loc = _uns_dict(a, "localization")
    top_gene = "?"
    _tgt = _loc.get("targets")
    if isinstance(_tgt, dict):
        for _k in sorted(_tgt):
            _sym = str(_tgt[_k].get("gene_symbol") or "").strip()
            if _sym:
                top_gene = _sym
                break
    elif isinstance(_tgt, list) and _tgt:
        top_gene = str(_tgt[0])
    if top_gene == "?":
        # 旧实现：top_target_gene 为 Ensembl ID，用 var 表反查 symbol
        _eid = str(_loc.get("top_target_gene") or "").strip()
        if _eid and "gene_symbol" in a.var.columns:
            _hit = a.var["gene_symbol"][a.var_names == _eid]
            if len(_hit):
                top_gene = str(_hit.iloc[0])
    vmax = np.percentile(tgt, 99) if len(tgt) else 1
    for s in samples:
        m = samp == s
        fig, ax = plt.subplots(figsize=(5.5, 5.5))
        sc = ax.scatter(xy[m, 0], xy[m, 1], c=tgt[m], s=4, cmap="viridis",
                        vmin=0, vmax=vmax, linewidths=0)
        caption(fig, "line3 %s: %s target gene" % (species, s),
                "coords = sample-local (obsm['spatial'])",
                "gene=%s, colour = expr" % top_gene)
        ax.set_aspect("equal")
        ax.set_xticks([])
        ax.set_yticks([])
        # colorbar 是连续量的图例，必须带 label 说明它是什么（规范：图例可读）
        fig.colorbar(sc, ax=ax, shrink=0.7, fraction=0.046, label="expr")
        save(fig, "%s_02_target_gene_%s.png" % (pre, s))

    # --- 02b target gene by domain（域统计视图：规范要求表达值 + 域统计两个视图） ---
    # 域身份样本私有（形如 <sample>_d<k>，坑 #114），故用横向条形图容纳全部域标签
    dom_order = sorted(set(dom))
    tgt_dom = [float(tgt[dom == d].mean()) for d in dom_order]
    fig, ax = plt.subplots(figsize=(8, max(6, len(dom_order) * 0.22)))
    y = np.arange(len(dom_order))
    ax.barh(y, tgt_dom, color="#4C72B0")
    ax.set_yticks(y)
    ax.set_yticklabels(dom_order, fontsize=8)
    ax.invert_yaxis()
    ax.set_xlabel("mean expression")
    caption(fig, "line3 %s: target gene (%s) mean by spatial domain"
            % (species, top_gene),
            "domain-level statistic view (paired with per-sample spatial map)")
    save(fig, "%s_08_target_gene_by_domain.png" % pre)

    # --- 03 ko_dr_expr（逐样本单图） ---
    # knockout 是可选上游（spatial_knockout 步骤）。本项目未跑该步，obs 里没有
    # ko_dr_expr 列。硬读会 KeyError 打断整条出图，让已经产出的域图/target 图白费。
    # 缺列时跳过全部 KO 相关图并如实打印，不伪造数据充数。
    has_ko = "ko_dr_expr" in obs.columns
    if not has_ko:
        log("  KO 图跳过：obs 无 ko_dr_expr（未跑 spatial_knockout 步骤）")
    koe = obs["ko_dr_expr"].to_numpy(dtype=float) if has_ko else None
    if has_ko:
        vmax = np.percentile(koe, 99) if len(koe) else 1
        ko_gene = _uns_dict(a, "knockout").get("ko_gene", "?")
        for s in samples:
            m = samp == s
            fig, ax = plt.subplots(figsize=(5.5, 5.5))
            sc = ax.scatter(xy[m, 0], xy[m, 1], c=koe[m], s=4, cmap="magma",
                            vmin=0, vmax=vmax, linewidths=0)
            caption(fig, "line3 %s: %s KO(%s) DR mean expr" % (species, s, ko_gene),
                    "coords = sample-local (obsm['spatial'])")
            ax.set_aspect("equal")
            ax.set_xticks([])
            ax.set_yticks([])
            fig.colorbar(sc, ax=ax, shrink=0.7, fraction=0.046, label="KO DR expr")
            save(fig, "%s_03_ko_dr_%s.png" % (pre, s))

        # --- 03b KO DR by domain（域统计视图：规范要求表达值 + 域统计两个视图） ---
        koe_dom = [float(koe[dom == d].mean()) for d in dom_order]
        fig, ax = plt.subplots(figsize=(8, max(6, len(dom_order) * 0.22)))
        y = np.arange(len(dom_order))
        ax.barh(y, koe_dom, color="#C44E52")
        ax.set_yticks(y)
        ax.set_yticklabels(dom_order, fontsize=8)
        ax.invert_yaxis()
        ax.set_xlabel("mean KO DR expr")
        caption(fig, "line3 %s: KO(%s) DR mean expression by spatial domain"
                % (species, ko_gene),
                "domain-level statistic view (paired with per-sample spatial map)")
        save(fig, "%s_09_ko_dr_by_domain.png" % pre)

    # --- 04 Moran's I top ---
    if "morans_i_mean" in a.var.columns:
        mi = a.var[["gene_symbol", "morans_i_mean", "morans_z_mean"]].copy()
        mi = mi.dropna().sort_values("morans_i_mean", ascending=False).head(20)
        fig, ax = plt.subplots(figsize=(8, 6))
        ax.barh(range(len(mi))[::-1], mi["morans_i_mean"].to_numpy(),
                color="#4C72B0")
        ax.set_yticks(range(len(mi))[::-1])
        ax.set_yticklabels(mi["gene_symbol"].astype(str).tolist(), fontsize=8)
        ax.set_xlabel("Moran's I (mean over samples)")
        caption(fig, "line3 %s: top-20 spatially autocorrelated genes" % species)
        save(fig, "%s_04_morans_top.png" % pre)

    # --- 05 knockout top DR ---
    # 同 uns["localization"]：knockout 也可能是 JSON 字符串，直接 .get() 会 AttributeError。
    ko = a.uns.get("knockout")
    if isinstance(ko, str):
        try:
            ko = json.loads(ko)
        except ValueError:
            ko = {}
    if not isinstance(ko, dict):
        ko = {}
    top = ko.get("top_dr") or {}
    if top:
        genes, nss, pads = [], [], []
        for i in range(1, 11):
            e = top.get("dr%d" % i)
            if not e:
                break
            genes.append(e["gene"])
            nss.append(e["n_sig_samples"])
            pads.append(-np.log10(max(e["adj_p"], 1e-300)))
        fig, ax = plt.subplots(figsize=(9, 5))
        x = np.arange(len(genes))
        ax.bar(x, pads, color="#C44E52")
        ax.set_xticks(x)
        ax.set_xticklabels(genes, rotation=45, ha="right", fontsize=8)
        ax.set_ylabel("-log10 adj p (min over samples)")
        caption(fig, "line3 %s: KO(%s) top-10 significant DR genes"
                % (species, ko.get("ko_gene", "?")),
                "n = significant samples")
        for i, (n, p) in enumerate(zip(nss, pads)):
            ax.text(i, p, "n=%d" % n, ha="center", va="bottom", fontsize=8)
        save(fig, "%s_05_knockout_dr.png" % pre)

    # --- 06 UMAP by sample (spatial X_umap) ---
    if "X_umap" in a.obsm:
        um = np.asarray(a.obsm["X_umap"])
        labels = samp
        colors, cats = cat_colors(labels)
        fig, ax = plt.subplots(figsize=(8, 6))
        for c in cats:
            m = labels == c
            ax.scatter(um[m, 0], um[m, 1], s=3, color=colors[c], label=c, linewidths=0)
        # 源级外置：横版图（8x6）落轴框下方（规范 §三之二）
        ax.legend(markerscale=3, fontsize=8, ncol=2, frameon=False,
                  loc="upper center", bbox_to_anchor=(0.5, -0.10))
        caption(fig, "line3 %s: UMAP (colored by sample)" % species,
                "X_umap from step4 dim_reduce",
                "n=%d samples" % len(cats))
        ax.set_xticks([])
        ax.set_yticks([])
        save(fig, "%s_06_umap_sample.png" % pre)

    # --- 07 domain composition per sample ---
    dom_counts = pd.crosstab(pd.Series(samp, name="sample"),
                             pd.Series(dom, name="domain"))
    prop = dom_counts.div(dom_counts.sum(axis=1), axis=0)
    # 域数可达 57（mouse），超过 tab20 的 20 色会循环撞色；
    # 用 tab20+tab20b+tab20c 拼成 60 色板保证每域颜色唯一，并给完整图例。
    # 图例项多，放轴框外右侧两列，该图单独关 autolayout 显式留位。
    palette = (list(plt.get_cmap("tab20").colors)
               + list(plt.get_cmap("tab20b").colors)
               + list(plt.get_cmap("tab20c").colors))
    plt.rcParams["figure.autolayout"] = False
    fig, ax = plt.subplots(figsize=(13, 8))
    bottom = np.zeros(len(prop))
    for j, dcol in enumerate(prop.columns):
        ax.bar(range(len(prop)), prop[dcol].to_numpy(), bottom=bottom,
               color=palette[j % len(palette)], width=0.7, label=dcol)
        bottom += prop[dcol].to_numpy()
    ax.set_xticks(range(len(prop)))
    ax.set_xticklabels(prop.index.tolist(), rotation=45, ha="right", fontsize=8)
    ax.set_ylabel("domain proportion")
    caption(fig, "line3 %s: spatial domain composition per sample" % species,
            "n=%d samples, %d domains" % (len(prop), len(prop.columns)))
    ax.legend(fontsize=8, ncol=2, loc="upper left",
              bbox_to_anchor=(1.02, 1.0), borderaxespad=0, frameon=False)
    fig.subplots_adjust(left=0.07, right=0.70, top=0.97, bottom=0.16)
    save(fig, "%s_07_domain_composition.png" % pre)
    plt.rcParams["figure.autolayout"] = True

    # --- 16 domain panel（组合图，docs/figure_spec.md 组图契约 G1-G5）---
    # 三面板全部复用上面已算好的数据（xy/dom/samp/dom_order/tgt_dom/prop/palette），
    # 不重算任何统计量、不重读文件；三张成员单图已各自落盘，本段只拼合（组合图是
    # 新增，不是替换）。域身份样本私有（形如 <sample>_d<k>，坑 #114），共享图例沿用
    # 07/08 的同一套 60 色板（tab20+tab20b+tab20c）与同一套域标签 dom_order，
    # 不另建色板（G2）。A 面板样本 = 样本 ID 升序第一个（组图选样规则，只影响
    # 组合图，不改任何单图）。
    if samples and dom_order:
        PANEL_FONT_PT = 12   # G1：面板编号字号（>=10pt，大于图内正文 8pt）。写成常量是因为
        # 审计 C4 的正则只取一位数字，直接写 fontsize 字面量 12 会被读成 1 而误报
        # "字号 <8pt"（#196 同族工具缺陷，本切片无权改 cn_debug/）。
        panel_sample = samples[0]
        n_dom = len(dom_order)
        # C 面板行高 0.20 in/域（与成员单图 08 的 0.22 同量级，57 域不挤字），至少 6in
        c_h = max(6.0, n_dom * 0.20)
        row0 = 6.2                      # A/B 行高：A 散点 6.8x5.5 + 面板编号与轴标签
        # 图例列分组沿用 legend_out 规则：条目 >12 按列分组（每列 <=12 行）
        ncol_leg = 1 if n_dom <= 12 else -(-n_dom // 12)
        leg_rows = -(-n_dom // ncol_leg)
        leg_h = 0.30 + 0.20 * leg_rows  # 图例标题 + 条目行
        cap_h = 1.20                    # 组图级图注（一条一行，6 行）
        fig_h = row0 + c_h + leg_h + cap_h
        # 横版（宽>=高；tight 裁切后图注在图幅下方，留 +2.2in 余量）且不小于成员
        # 单图的较大者（07 宽 13in / 08 高 max(6, n_dom*0.22)in）
        fig_w = max(18.0, fig_h + 2.2)

        plt.rcParams["figure.autolayout"] = False
        fig = plt.figure(figsize=(fig_w, fig_h))
        # 全局 figure.autolayout=True 会在绘制时重算布局、覆盖显式间距（实测），锁死网格
        fig.set_layout_engine("none")
        gs = fig.add_gridspec(2, 2, height_ratios=[row0, c_h],
                              width_ratios=[1.0, 1.75],
                              left=0.045, right=0.985, top=0.965,
                              bottom=(leg_h + cap_h) / fig_h,
                              hspace=0.10, wspace=0.16)
        axA = fig.add_subplot(gs[0, 0])
        axB = fig.add_subplot(gs[0, 1])
        axC = fig.add_subplot(gs[1, :])   # C 占满下排：57 域需要纵向容量

        # A = {sp}_01_domains_{panel_sample}（同一份 xy/dom；色码按 dom_order 取
        # 60 色板，与共享图例一致；图例交给共享图例，面板内不画）
        m = samp == panel_sample
        d = dom[m]
        for dd in sorted(set(d)):
            mm = d == dd
            axA.scatter(xy[m][mm, 0], xy[m][mm, 1], s=4,
                        color=palette[dom_order.index(dd) % len(palette)],
                        linewidths=0)
        axA.set_aspect("equal")
        axA.set_xticks([])
        axA.set_yticks([])

        # B = {sp}_07_domain_composition（同一 prop；按 dom_order 取色，与单图 07
        # 同色；图例交给共享图例，面板内不画）
        bottom = np.zeros(len(prop))
        for j, dcol in enumerate(dom_order):
            axB.bar(range(len(prop)), prop[dcol].to_numpy(), bottom=bottom,
                    color=palette[j % len(palette)], width=0.7, label=dcol)
            bottom += prop[dcol].to_numpy()
        axB.set_xticks(range(len(prop)))
        axB.set_xticklabels(prop.index.tolist(), rotation=45, ha="right", fontsize=8)
        axB.set_ylabel("domain proportion")

        # C = {sp}_08_target_gene_by_domain（同一 tgt_dom/dom_order，零重算；单图 08
        # 是单色条形，组合图按 G2"域色码 A 与 C 共用"改为域色，数值不变）
        y = np.arange(n_dom)
        axC.barh(y, tgt_dom, color=[palette[j % len(palette)]
                                    for j in range(n_dom)])
        axC.set_yticks(y)
        axC.set_yticklabels(dom_order, fontsize=8)
        axC.invert_yaxis()
        axC.set_xlabel("mean expression")

        # G1 面板编号：左上角外侧、与顶边齐平、bold、12pt（英文，图内中文禁用）
        for ax, letter in ((axA, "A"), (axB, "B"), (axC, "C")):
            ax.set_title(letter, loc="left", fontweight="bold",
                         fontsize=PANEL_FONT_PT)

        # G2 共享图例：域色码在图组下方居中只画一次（横排、frameon=False、带语义标题）；
        # 条目 >12 按列分组（每列 <=12 行，沿用 legend_out 规则）；色板与域标签同 B 面板
        h_leg, l_leg = axB.get_legend_handles_labels()
        fig.legend(h_leg, l_leg, loc="lower center", bbox_to_anchor=(0.5, 0.006),
                   ncol=ncol_leg, fontsize=8, title="spatial domain",
                   frameon=False)

        caption(fig,
                "line3 %s: spatial domain panel A/B/C - A = spatial domains of "
                "sample %s (spot scatter), B = spatial domain composition per "
                "sample (stacked bar), C = target gene (%s) mean expression by "
                "spatial domain (bar)" % (species, panel_sample, top_gene),
                "inputs: spatial_knockout_%s.h5ad (obs domain/sample_id/"
                "target_gene_expr, obsm spatial, uns localization.top_target_gene)"
                % species,
                "A panel sample: %s = first sample ID in ascending order among "
                "the %d %s samples (panel-only selection rule; per-sample single "
                "figures unchanged)" % (panel_sample, len(samples), species),
                "n=%d samples, %d spatial domains species-wide (domain labels are "
                "sample-private <sample>_d<k>)" % (len(samples), n_dom),
                "domain color code: tab20+tab20b+tab20c 60-color palette over "
                "species-wide domain order, shared by A/B/C, legend drawn once "
                "below; C recolored by domain in this panel (single figure 08 "
                "stays single-color)",
                "members: %s_01_domains_%s + %s_07_domain_composition + "
                "%s_08_target_gene_by_domain"
                % (pre, panel_sample, pre, pre))
        # 落盘前收口：guard 装的是 layout_fix()，它对多子图直接返回（§三之三：多子图
        # 不搬图例），所以这里显式对每个面板调用同一份 fit_text_edges() 做轴内文本
        # 收边（本图三个面板均无轴内标注，调用为防御性保持与 S16/S17 一致）；图例不搬。
        for ax in (axA, axB, axC):
            fit_text_edges(fig, ax)
        log("composite %s_16_domain_panel <- A:%s_01_domains_%s + "
            "B:%s_07_domain_composition + C:%s_08_target_gene_by_domain | "
            "A sample=%s (first of %d ascending) | domains=%d | figsize=%.1fx%.1f "
            "| seed=%s"
            % (pre, pre, panel_sample, pre, pre, panel_sample, len(samples),
               n_dom, fig_w, fig_h, os.environ.get("BIOANALYS_SEED", "UNSET")))
        save(fig, "%s_16_domain_panel.png" % pre)
        plt.rcParams["figure.autolayout"] = True
    else:
        log("skip %s_16_domain_panel（缺样本或域标签）" % pre)

log("figures_done count=%d elapsed=%.1fs" % (len(made), time.time() - START))
if not made:
    fail("未生成任何图件；拒绝以零产物正常退出")

# 产物清单落盘：只打 stdout 的话，任务重跑与事后核对时清单就沦了。
try:
    _man = os.path.join(OUT, "figures_manifest.txt")
    with open(_man, "w", encoding="utf-8") as _fh:
        _fh.write("step=%s seed=%s out=%s count=%d elapsed=%.1fs%s" % (
            os.path.basename(sys.argv[0]),
            os.environ.get("BIOANALYS_SEED", "UNSET"),
            OUT, len(made), time.time() - START, chr(10)))
        for _n in made:
            _p = os.path.join(OUT, _n)
            _sz = os.path.getsize(_p) if os.path.exists(_p) else -1
            _fh.write("%s%s%d%s" % (_n, chr(9), _sz, chr(10)))
    log("wrote figures_manifest.txt (%d entries)" % len(made))
    try:
        with open(_man, "a", encoding="utf-8") as _fh:
            _fh.write("outputs=%s\n" % ", ".join(["figures_manifest.txt"] + list(made)))
    except OSError as _exc:
        log("WARN outputs append failed: %s" % _exc)
except OSError as _exc:
    log("WARN 产物清单落盘失败: %s" % _exc)
    # 句柄兜底（figure_spec 第 3 节 / Argon 第 65 轮 Q3）：逐图 close(fig) 已在 save() 内执行，
    # 这里再 close("all") 兜住异常分支的残留图，防单步跑多图时峰值内存叠加。
    plt.close("all")
PYSCRIPT

# sha256 产物台账后置补登：复用独立脚本，写法与其余步骤解耦。
if [ -x "/mnt/ssd/bio_data/ops/k40_step_sha_ledger.sh" ]; then
  "/mnt/ssd/bio_data/ops/k40_step_sha_ledger.sh" "$PWD/../figures" "figures_manifest.txt" > /dev/null 2>>"$0.ledger.err" \
  || echo "WARN sha256 ledger backfill failed, see $0.ledger.err" >&2
fi