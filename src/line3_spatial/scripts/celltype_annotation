#!/usr/bin/env bash
# PROVENANCE: INDEPENDENT  本脚本出图代码为独立实现，未派生自 reference/05.可参考出图代码 的源码；
# celltype_annotation：line3_spatial 步骤 11 轻量级细胞类型注释 / 反卷积
# aims 线3 下游第 7 项（v2.3 反卷积白名单 1/2/3 需 R Seurat/CARD/RCTD，容器未装，
# 按 P2 裁决用 Python 轻量方案替代：NNLS 非负最小二乘 + marker 基因打分）。
#
# 输入（cwd 下）：
#   spatial_marker_mouse.h5ad / spatial_marker_human.h5ad（步骤 6 产物，含 domain_markers）
#   domain_markers_mouse.tsv / domain_markers_human.tsv（步骤 6 top20 per domain）
# 输出（cwd 下）：
#   celltype_scores_{species}.tsv（spot x celltype NNLS 丰度矩阵）
#   celltype_annotation_{species}.tsv（每 spot 首选 celltype + 次选 + 置信度）
#   deconv_report.txt
#   ../figures/l3_{species}_14_deconv_umap.png（UMAP 按 celltype 着色）
#   ../figures/l3_{species}_15_deconv_composition.png（域内 celltype 组成条形）
#
# 口径：
#   1. 细胞类型参考 marker 集：从域 marker 表提取每域 top5 基因作为该域代表签名，
#      合并为 marker x celltype 签名矩阵（基因在签名中=1，否则=0）。
#   2. NNLS 解卷积：对每 spot 的表达向量，用 scipy.optimize.nnls 求解
#      min ||A*x - b|| s.t. x >= 0，A = 签名矩阵（spot 的基因子集），b = spot 表达。
#      x 归一化为比例（sum=1），得每 spot 各 celltype 丰度比例。
#   3. 注释：取丰度最高的 celltype 为首选，次高为次选，首选占比 / (首选+次选) 为置信度。
#   4. 不依赖外部参考数据集（白名单工具 TransferData/CARD/RCTD 需 Seurat，
#      容器未装；本方案用域 marker 自签名，属无监督近似）。
#
# 口径：docs/figure_spec.md（Agg/300dpi/英文标签；图注置坐标轴框外；
#       图例不压数据；DR 角标不适用此处非敲除产物）。
set -euo pipefail

seed="${BIOANALYS_SEED:-UNSET}"
if [ "$seed" = "UNSET" ]; then
  echo "BIOANALYS_SEED 未注入（引擎契约：seed 必须注入）" >&2
  exit 3
fi

declare -a INPUTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --input) INPUTS+=("$2"); shift 2 ;;
    --output) shift 2 ;;
    --seed) shift 2 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
done

echo "step_executed=celltype_annotation"
echo "bioanalys_seed=${seed}"

# 解释器 PATH 前置（生信代码专项审核）：K40 系统解释器缺科学计算包，真依赖在 bio-py venv。
# 用 PATH 注入而非改写调用行，是为了让桥接调用的行级计数保持原样（bilingual 判定不变）。
BIO_PY_BIN="${BIO_PY_BIN:-/root/venvs/bio-py/bin}"
if [ -x "$BIO_PY_BIN/python3" ]; then
  export PATH="$BIO_PY_BIN:$PATH"
fi

python3 - <<'PYSCRIPT'
import hashlib
import os
import sys
import time

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib.patches import Patch
import numpy as np
import pandas as pd
import anndata as ad
import scanpy as sc
from scipy.optimize import nnls

ad.settings.allow_write_nullable_strings = False
plt.rcParams.update({
    "figure.dpi": 300, "savefig.dpi": 300, "font.size": 9,
    "axes.titlesize": 10, "axes.grid": False,
    "figure.autolayout": True, "savefig.bbox": "tight",
    "image.cmap": "viridis",
})

START = time.time()
SEED = int(os.environ["BIOANALYS_SEED"])
TOP_MARKERS_PER_DOMAIN = 5
FIGDIR = os.path.join("..", "figures")
os.makedirs(FIGDIR, exist_ok=True)


def fail(m):
    sys.stderr.write("celltype_annotation 自校验失败: %s\n" % m)
    sys.stderr.flush()
    sys.exit(1)


def log(m):
    print(m, flush=True)


def caption(fig, *parts):
    """图注置于坐标轴框外：竖版图（宽<高）在右上角纵向多行；
    横版图（宽>=高）在图幅下方纵向多行（一条一行，不横向拼接）。"""
    parts = [str(p) for p in parts if p not in (None, "")]
    if not parts:
        return
    w, h = fig.get_size_inches()
    text = "\n".join(parts)
    if w >= h:
        fig.text(0.01, -0.02, text, ha="left", va="top", fontsize=8,
                 linespacing=1.5)
    else:
        fig.text(1.02, 1.0, text, ha="left", va="top", fontsize=8,
                 linespacing=1.5)


def wrap_label(text, width=18):
    """长标签换行：超宽标签优先按 _ 边界折行，仍超宽再按字符折行，防溢出图框。"""
    import textwrap

    s = str(text)
    if len(s) <= width:
        return s
    lines, cur = [], ""
    for part in s.split("_"):
        joined = part if not cur else cur + "_" + part
        if cur and len(joined) > width:
            lines.append(cur)
            cur = part
        else:
            cur = joined
    if cur:
        lines.append(cur)
    if max(len(x) for x in lines) <= width:
        return "\n".join(lines)
    out = []
    for line in lines:
        out.extend(textwrap.wrap(line, width=width) or [line])
    return "\n".join(out)


def fit_text_edges(fig, ax, gap=6.0, rounds=5):
    """把越出坐标轴框的轴内文本收进框内：右缘/顶缘/左缘/下缘越界时自动扩 xlim/ylim。
    实测像素宽度迭代收敛（至少留 6px 边距，比审计容差 3px 更严），柱顶数值标注与条形
    末端外挂标注都按同一规则留位；若扩一轮越界没有改善（文本框锚在轴坐标而非数据坐标）
    就停手，防无意义放大把主图压扁。"""
    prev = None
    for _ in range(rounds):
        fig.canvas.draw()
        rend = fig.canvas.get_renderer()
        bb = ax.get_window_extent()
        boxes = [t.get_window_extent(renderer=rend) for t in ax.texts
                 if t.get_text().strip()]
        if not boxes:
            return
        bw = max(bb.width, 1e-6)
        bh = max(bb.height, 1e-6)
        right = max(b.x1 for b in boxes) - bb.x1
        top = max(b.y1 for b in boxes) - bb.y1
        left = bb.x0 - min(b.x0 for b in boxes)
        bottom = bb.y0 - min(b.y0 for b in boxes)
        if max(right, top, left, bottom) <= gap:
            return
        worst = max(right / bw, top / bh, left / bw, bottom / bh)
        if prev is not None and worst >= prev * 0.98:
            return
        prev = worst
        x0, x1 = ax.get_xlim()
        y0, y1 = ax.get_ylim()
        if right > gap:
            ax.set_xlim(x0, x1 + (x1 - x0) * (right / bw) * 1.15)
            x0, x1 = ax.get_xlim()
        if left > gap:
            ax.set_xlim(x0 - (x1 - x0) * (left / bw) * 1.15, x1)
            x0, x1 = ax.get_xlim()
        if top > gap:
            ax.set_ylim(y0, y1 + (y1 - y0) * (top / bh) * 1.15)
            y0, y1 = ax.get_ylim()
        if bottom > gap:
            ax.set_ylim(y0 - (y1 - y0) * (bottom / bh) * 1.15, y1)


def legend_out(ax, fig, leg):
    """图例移到坐标轴框外：竖版图（宽<高）右上角纵向单列；横版图（宽>=高）下方纵向单列。
    条目超过 12 条按列分组，避免纵向过长压扁主图。"""
    n = len(leg.get_texts())
    handles = list(leg.legend_handles)
    labels = [t.get_text() for t in leg.get_texts()]
    title = leg.get_title().get_text() or None
    w, h = fig.get_size_inches()
    fig.set_layout_engine("none")
    if w >= h:
        ncol = 1 if n <= 12 else -(-n // 12)
        rows = -(-n // ncol)
        ax.legend(handles, labels, loc="upper center", bbox_to_anchor=(0.5, -0.10),
                  ncol=ncol, fontsize=8, frameon=False, title=title)
        fig.subplots_adjust(bottom=min(0.58, 0.16 + 0.045 * rows))
    else:
        ax.legend(handles, labels, loc="upper left", bbox_to_anchor=(1.02, 1.0),
                  ncol=1, fontsize=8, frameon=False, title=title)
        fig.subplots_adjust(right=0.74)


def layout_fix(fig):
    """落盘前统一收口（docs/figure_spec.md v2.2 §三之三）：
    1) 单坐标轴图的图例外置：竖版置轴框外右上角、横版置轴框下方，纵向排布、不压数据；
    2) 轴内文本右缘/顶缘/左缘/下缘越出坐标轴框时自动扩 xlim/ylim 收进框内。
    多子图（分面）图不做图例搬迁：分面各有自己的图例，统一外移会互相压扁。
    tick 标签一律不动：它本就在轴框外，savefig.bbox="tight" 会把画布扩到装下它；
    强行换行反而让多行标签在密集类目轴上互相压字（实测见踩坑台账）。"""
    from matplotlib.colorbar import Colorbar

    axes = [a for a in fig.get_axes() if not isinstance(a, Colorbar)]
    if not axes:
        return
    if len(axes) == 1:
        leg = axes[0].get_legend()
        if leg is not None:
            legend_out(axes[0], fig, leg)
        fit_text_edges(fig, axes[0])


def _install_layout_guard():
    """装一次全局收口：脚本内任何 fig.savefig 落盘前先走 layout_fix()，
    以后新增图自动套版式规则，不靠人记得调用（docs/figure_spec.md v2.2 §三之三）。"""
    from matplotlib.figure import Figure

    if getattr(Figure.savefig, "_layout_guard", False):
        return
    orig = Figure.savefig

    def guarded(self, fname, *a, **kw):
        layout_fix(self)
        return orig(self, fname, *a, **kw)

    guarded._layout_guard = True
    guarded._orig_savefig = orig
    Figure.savefig = guarded


_install_layout_guard()


def cat_colors(labels):
    """确定性分类配色：tab20+tab20b+tab20c 拼 60 色"""
    cats = sorted(set(labels))
    palette = (list(plt.get_cmap("tab20").colors)
               + list(plt.get_cmap("tab20b").colors)
               + list(plt.get_cmap("tab20c").colors))
    return {c: palette[i % len(palette)] for i, c in enumerate(cats)}, cats


report_lines = [
    "step=celltype_annotation",
    "seed=%d" % SEED,
    "method=NNLS deconvolution (scipy.optimize.nnls) + scanpy.tl.score_genes validation",
    "note=轻量级方案：NNLS 域 marker 签名解卷积 + score_genes 补充验证 celltype 打分",
    "note_ref=不依赖 Seurat/CARD/RCTD（虽然容器已装 Seurat，但本方案不取自 line2 参考）",
    "signature_note=A 是域 marker 自签名，不是外部细胞类型参考表达谱；结果按无监督近似解释",
    "",
]

for species in ["mouse", "human"]:
    h5ad = "spatial_marker_%s.h5ad" % species
    mk_tsv = "domain_markers_%s.tsv" % species
    for f in [h5ad, mk_tsv]:
        if not os.path.exists(f):
            fail("缺少输入 %s（步骤 6 产物）" % f)

    a = ad.read_h5ad(h5ad)
    mk = pd.read_csv(mk_tsv, sep="\t")
    if "gene_symbol" not in mk.columns or "group" not in mk.columns:
        fail("%s 缺 gene_symbol 或 group 列" % mk_tsv)

    # 1. 构建域签名：每域 top5 marker 基因
    domains = sorted(mk["group"].astype(str).unique().tolist())
    sig_genes = set()
    sig_dict = {}
    for dom in domains:
        sub = mk[mk["group"].astype(str) == dom].sort_values("scores", ascending=False)
        top_genes = sub["gene_symbol"].astype(str).head(TOP_MARKERS_PER_DOMAIN).tolist()
        sig_dict[dom] = top_genes
        sig_genes.update(top_genes)
    sig_genes = sorted(sig_genes & set(a.var["gene_symbol"].astype(str)))
    if len(sig_genes) < 10:
        fail("%s 签名基因 %d < 10" % (species, len(sig_genes)))
    log("=== %s: %d domains, %d signature genes ===" % (species, len(domains), len(sig_genes)))

    # 签名矩阵 A (gene x celltype)：基因在该域签名中=1，否则=0
    A = np.zeros((len(sig_genes), len(domains)), dtype=float)
    gene_idx = {g: i for i, g in enumerate(sig_genes)}
    var_symbol = a.var["gene_symbol"].astype(str)
    for j, dom in enumerate(domains):
        for g in sig_dict[dom]:
            if g in gene_idx:
                A[gene_idx[g], j] = 1.0

    # 2. NNLS 解卷积：每 spot 的表达向量对签名矩阵求解
    X = a.X
    X = np.asarray(X.todense()) if hasattr(X, "todense") else np.asarray(X)
    # 同一 symbol 可能对应多个 var 行。A 每个 symbol 只有一行，因此只取首个表达列，
    # 并强制列顺序与 gene_idx 一致，防止重复 symbol 让 NNLS 维度错位后静默全零。
    var_symbols = var_symbol.to_numpy()
    symbol_to_idx = {}
    for i, symbol in enumerate(var_symbols):
        if symbol in gene_idx and symbol not in symbol_to_idx:
            symbol_to_idx[symbol] = i
    missing_sig = [g for g in sig_genes if g not in symbol_to_idx]
    if missing_sig:
        fail("%s 签名基因缺表达列: %s" % (species, ", ".join(missing_sig[:10])))
    sig_var_indices = np.array([symbol_to_idx[g] for g in sig_genes], dtype=int)
    X_sig = X[:, sig_var_indices]  # spot x signature_genes
    if X_sig.shape[1] != A.shape[0]:
        fail("%s 签名表达列 %d != 签名矩阵行 %d" % (species, X_sig.shape[1], A.shape[0]))

    n_spots = X_sig.shape[0]
    n_ct = len(domains)
    scores = np.zeros((n_spots, n_ct), dtype=float)
    solved = 0
    solve_failures = 0
    last_solve_error = ""
    for i in range(n_spots):
        b = X_sig[i]
        if not np.any(b > 0):
            continue
        try:
            x, _ = nnls(A, b)
            scores[i] = x
            solved += 1
        except Exception as exc:
            solve_failures += 1
            last_solve_error = str(exc)
    if solved == 0:
        fail("%s NNLS 无任何成功求解（失败 %d；最后错误: %s）"
             % (species, solve_failures, last_solve_error[:300]))
    log("%s NNLS solved=%d failed=%d" % (species, solved, solve_failures))
    # 归一化为比例
    row_sums = scores.sum(axis=1, keepdims=True)
    row_sums[row_sums == 0] = 1.0
    props = scores / row_sums

    # 3. 注释
    primary = props.argmax(axis=1)
    sorted_idx = np.argsort(props, axis=1)
    primary_ct = [domains[primary[i]] for i in range(n_spots)]
    secondary_ct = [domains[sorted_idx[i, -2]] if n_ct > 1 else "" for i in range(n_spots)]
    confidence = np.array([
        props[i, primary[i]] / (props[i, primary[i]] + props[i, sorted_idx[i, -2]] + 1e-12)
        if n_ct > 1 else props[i, primary[i]]
        for i in range(n_spots)
    ])

    # 3b. score_genes 补充验证：对每域签名基因集做 scanpy.tl.score_genes，
    # 交叉验证 NNLS 注释一致性（score 最高域与 NNLS primary 一致率）
    # var_names 是 Ensembl ID，需映射到 gene_symbol 后取交集
    var_sym_to_id = {}
    if "gene_symbol" in a.var.columns:
        for vid, sym in zip(a.var_names, a.var["gene_symbol"].astype(str)):
            var_sym_to_id[sym] = vid
    score_cols = []
    for dom in domains:
        col = "score_%s" % dom
        # 签名基因映射为 var_names (Ensembl ID)，取在矩阵中存在的
        genes_for_dom = [var_sym_to_id[g] for g in sig_dict[dom]
                         if g in var_sym_to_id and var_sym_to_id[g] in a.var_names]
        if len(genes_for_dom) >= 3:
            sc.tl.score_genes(a, gene_list=genes_for_dom, score_name=col, use_raw=False)
            score_cols.append(col)
    if score_cols:
        score_mat = a.obs[score_cols].to_numpy()
        score_primary = score_mat.argmax(axis=1)
        # 一致率：score_genes 首选域 vs NNLS primary 域
        agreement = float(np.mean([
            score_cols[score_primary[i]] == ("score_%s" % primary_ct[i])
            for i in range(n_spots)
        ]))
        log("%s score_genes agreement with NNLS: %.1f%%" % (species, agreement * 100))
    else:
        agreement = float("nan")

    # 落盘
    scores_df = pd.DataFrame(props, index=a.obs_names, columns=domains)
    scores_df.index.name = "spot"
    scores_df.to_csv("celltype_scores_%s.tsv" % species, sep="\t")

    annot_df = pd.DataFrame({
        "spot": a.obs_names,
        "domain": a.obs["domain"].astype(str).to_numpy(),
        "primary_celltype": primary_ct,
        "secondary_celltype": secondary_ct,
        "primary_proportion": props.max(axis=1),
        "confidence": confidence,
    })
    annot_df.to_csv("celltype_annotation_%s.tsv" % species, sep="\t", index=False)
    log("wrote celltype_scores_%s.tsv (%d spots x %d celltypes)" % (species, n_spots, n_ct))
    log("wrote celltype_annotation_%s.tsv (%d spots)" % (species, n_spots))

    # 贴回 h5ad
    ct_series = pd.Series(primary_ct, index=a.obs_names, dtype="category")
    a.obs["celltype_nnls"] = ct_series
    a.write_h5ad("spatial_deconv_%s.h5ad" % species)

    # 4. 出图：UMAP 按 celltype 着色
    # 确保 X_umap 存在
    if "X_umap" not in a.obsm:
        log("%s 无 X_umap，跳过 UMAP 图" % species)
    else:
        umap = a.obsm["X_umap"]
        cmap, uniq_cts = cat_colors(primary_ct)
        colors = [cmap[c] for c in primary_ct]
        plt.rcParams["figure.autolayout"] = False
        fig, ax = plt.subplots(figsize=(9, 7))
        ax.scatter(umap[:, 0], umap[:, 1], c=colors, s=8, alpha=0.7, edgecolors="none")
        ax.set_xlabel("UMAP 1")
        ax.set_ylabel("UMAP 2")
        n_ct_show = len(uniq_cts)
        if n_ct_show <= 20:
            ax.legend(handles=[Patch(color=cmap[c], label=c) for c in uniq_cts],
                      fontsize=8, loc="center left", bbox_to_anchor=(1.02, 0.5),
                      frameon=False, title="celltype (NNLS)", title_fontsize=8)
            fig.subplots_adjust(left=0.08, right=0.72, top=0.96, bottom=0.09)
        else:
            caption_note = "%d celltypes colored (see celltype_annotation_%s.tsv for labels)" % (n_ct_show, species)
            caption(fig, "line3 %s: NNLS deconvolution celltype UMAP" % species,
                    "spatial_marker_%s.h5ad from step6; NNLS on domain-marker signatures" % species,
                    "n=%d spots, %d celltypes; %s" % (n_spots, n_ct_show, caption_note))
            fig.subplots_adjust(left=0.08, right=0.97, top=0.96, bottom=0.09)
        if n_ct_show <= 20:
            caption(fig, "line3 %s: NNLS deconvolution celltype UMAP" % species,
                    "spatial_marker_%s.h5ad from step6; NNLS on domain-marker signatures" % species,
                    "n=%d spots, %d celltypes; color = primary celltype" % (n_spots, n_ct_show))
        fig.savefig(os.path.join(FIGDIR, "l3_%s_14_deconv_umap.png" % species))
        plt.close(fig)
        plt.rcParams["figure.autolayout"] = True
        log("wrote l3_%s_14_deconv_umap.png" % species)

    # 5. 出图：域内 celltype 组成条形（每域 top5 celltype 均值比例）
    domain_col = a.obs["domain"].astype(str).to_numpy()
    comp_rows = []
    for dom in sorted(set(domain_col)):
        mask = domain_col == dom
        if mask.sum() == 0:
            continue
        mean_props = props[mask].mean(axis=0)
        top_idx = np.argsort(mean_props)[::-1][:5]
        for j in top_idx:
            comp_rows.append({"domain": dom, "celltype": domains[j],
                              "mean_proportion": float(mean_props[j])})
    comp = pd.DataFrame(comp_rows)
    if len(comp):
        plt.rcParams["figure.autolayout"] = False
        n_domains = comp["domain"].nunique()
        fig_h = max(5, n_domains * 0.45)
        fig, ax = plt.subplots(figsize=(11, fig_h))
        dom_list = sorted(comp["domain"].unique())
        y_pos = np.arange(len(dom_list))
        cmap, _ = cat_colors(comp["celltype"].tolist())
        bottoms = np.zeros(len(dom_list))
        for ct in sorted(comp["celltype"].unique()):
            vals = comp[comp["celltype"] == ct].set_index("domain")["mean_proportion"]
            vals = vals.reindex(dom_list, fill_value=0).to_numpy()
            ax.barh(y_pos, vals, left=bottoms, color=cmap[ct], height=0.7, label=ct)
            bottoms += vals
        ax.set_yticks(y_pos)
        ax.set_yticklabels(dom_list, fontsize=8)
        ax.set_xlabel("mean proportion")
        if len(comp["celltype"].unique()) <= 20:
            ax.legend(fontsize=8, loc="center left", bbox_to_anchor=(1.02, 0.5),
                      frameon=False, title="celltype")
            fig.subplots_adjust(left=0.14, right=0.68, top=0.96, bottom=0.10)
        else:
            fig.subplots_adjust(left=0.14, right=0.97, top=0.96, bottom=0.10)
        caption(fig, "line3 %s: domain celltype composition (NNLS deconvolution)" % species,
                "top5 celltypes per domain by mean proportion",
                "n=%d spots, %d domains" % (n_spots, n_domains))
        fig.savefig(os.path.join(FIGDIR, "l3_%s_15_deconv_composition.png" % species))
        plt.close(fig)
        plt.rcParams["figure.autolayout"] = True
        log("wrote l3_%s_15_deconv_composition.png" % species)

    # 报告段
    ct_counts = pd.Series(primary_ct).value_counts()
    report_lines += [
        "=== %s ===" % species,
        "spots=%d genes=%d domains=%d signature_genes=%d" % (n_spots, a.n_vars, len(domains), len(sig_genes)),
        "nnls_deconvolution: A=%dx%d, solved %d spots" % (len(sig_genes), n_ct, n_spots),
        "top_celltypes: %s" % ", ".join("%s(%d)" % (ct, cnt) for ct, cnt in ct_counts.head(5).items()),
        "mean_confidence=%.3f median_confidence=%.3f" % (float(confidence.mean()), float(np.median(confidence))),
        "score_genes_agreement_with_nnls=%.1f%%" % (agreement * 100 if not np.isnan(agreement) else -1),
        "",
    ]

report_lines += [
    "limitations:",
    "  1. 域签名来自域 marker top5（无监督自签名），非外部参考单细胞数据集；",
    "     注释结果是对空间域转录特征的近似分型，不等同于真正的反卷积。",
    "  2. NNLS 假设表达 = 签名线性组合 + 非负约束，忽略噪声与跨域基因共表达。",
    "  3. 白名单工具(TransferData/CARD/RCTD)需 R Seurat，容器未装；",
    "     若需精确反卷积，需另装 R 包 + 公共参考图谱。",
    "",
    "elapsed_seconds=%.1f" % (time.time() - START),
    "outputs=celltype_scores_mouse.tsv, celltype_scores_human.tsv, celltype_annotation_mouse.tsv, celltype_annotation_human.tsv, spatial_deconv_mouse.h5ad, spatial_deconv_human.h5ad, ../figures/l3_mouse_14_deconv_umap.png, ../figures/l3_mouse_15_deconv_composition.png, ../figures/l3_human_14_deconv_umap.png, ../figures/l3_human_15_deconv_composition.png, deconv_report.txt",
]
with open("deconv_report.txt", "w", encoding="utf-8") as fh:
    fh.write("\n".join(report_lines) + "\n")

for _artifact in sorted(os.listdir(".")):
    if not os.path.isfile(_artifact):
        continue
    if _artifact == 'deconv_report.txt':
        continue
    with open(_artifact, "rb") as _fh:
        _digest = hashlib.sha256(_fh.read()).hexdigest()
    with open('deconv_report.txt', "a", encoding="utf-8") as _fh:
        _fh.write("%s_sha256=%s\n" % (_artifact, _digest))
log("celltype_annotation_done")
# 句柄兜底（figure_spec 第 3 节 / Argon 第 65 轮 Q3）：逐图 close(fig) 已在 save() 内执行，
# 这里再 close("all") 兜住异常分支的残留图，防单步跑多图时峰值内存叠加。
plt.close("all")
PYSCRIPT

# sha256 产物台账后置补登：复用独立脚本，写法与其余步骤解耦。
if [ -x "/mnt/ssd/bio_data/ops/k40_step_sha_ledger.sh" ]; then
  "/mnt/ssd/bio_data/ops/k40_step_sha_ledger.sh" "$PWD" "deconv_report.txt" > /dev/null 2>>"$0.ledger.err" \
  || echo "WARN sha256 ledger backfill failed, see $0.ledger.err" >&2
fi