#!/usr/bin/env bash
# scrna_figures：line2_scrna 出图脚本（读步骤 14/15 产物，产 PNG 供目视审核）。
#
# PROVENANCE: INDEPENDENT  本脚本出图代码为独立实现，未派生自 reference/05.可参考出图代码 的源码；
#   参考库仅用于风格与手法借鉴，不构成代码派生关系。
# 输入：scrna_deg.h5ad（含 obs celltype/diagnosis/donor/leiden + obsm X_umap/X_pca
#       + uns composition/deg/cluster_markers）。
# 输出（写到 ../figures/，独立出图目录）：
#   01_umap_celltype.png / 02_umap_diagnosis.png / 03_umap_donor.png /
#   04_umap_leiden.png / 05_composition_stack.png / 06_composition_box.png /
#   07_marker_top5.png / 08_deg_volcano.png / 09_deg_sig_bar.png /
#   10_pca_diagnosis.png（95% 置信椭圆）
#
# 口径：图件规范见 docs/figure_spec.md（Agg/300dpi/英文标签；火山图上调红下调蓝；
#       PCA 带 95% 置信椭圆；图注置于坐标轴框外，横版图在下方横向一行，
#       竖版图在右上角纵向多行）。
set -euo pipefail

seed="${BIOANALYS_SEED:-UNSET}"
if [ "$seed" = "UNSET" ]; then
  echo "BIOANALYS_SEED 未注入（引擎契约：seed 必须注入）" >&2
  exit 3
fi

declare -a INPUTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --input) INPUTS+=("$2"); shift 2 ;;
    --output) shift 2 ;;
    --seed) shift 2 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
done

src_h5ad=""
for path in "${INPUTS[@]:-}"; do
  [ -n "$path" ] || continue
  case "$path" in
    *scrna_deg*.h5ad) src_h5ad="$path" ;;
    *.h5ad) src_h5ad="$path" ;;
    *) echo "无法识别的输入文件: $path（需要 *.h5ad）" >&2; exit 2 ;;
  esac
done
if [ -z "$src_h5ad" ] || [ ! -f "$src_h5ad" ]; then
  echo "缺少必需输入：scrna_deg.h5ad（步骤 15 产物）" >&2
  exit 2
fi

echo "step_executed=scrna_figures"
echo "bioanalys_seed=${seed}"
echo "input=${src_h5ad}"

FIG_INPUT="$src_h5ad"
export FIG_INPUT

# 解释器 PATH 前置（生信代码专项审核）：K40 系统解释器缺科学计算包，真依赖在 bio-py venv。
# 用 PATH 注入而非改写调用行，是为了让桥接调用的行级计数保持原样（bilingual 判定不变）。
BIO_PY_BIN="${BIO_PY_BIN:-/root/venvs/bio-py/bin}"
if [ -x "$BIO_PY_BIN/python3" ]; then
  export PATH="$BIO_PY_BIN:$PATH"
fi

python3 - <<'PYSCRIPT'
import json
import os
import sys
import time

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib import colors as mcolors
from matplotlib.patches import Ellipse
import numpy as np
import pandas as pd
import anndata as ad

ad.settings.allow_write_nullable_strings = False
plt.rcParams.update({
    "figure.dpi": 300, "savefig.dpi": 300, "font.size": 9,
    "axes.titlesize": 10, "axes.grid": False,
    "figure.autolayout": True, "savefig.bbox": "tight",
    "image.cmap": "viridis",
})

START = time.time()
OUT = "../figures"
os.makedirs(OUT, exist_ok=True)
made = []
# 火山三色与 CASE_COLOR / CTRL_COLOR 同一色族（docs/figure_spec.md §八.5）：
# 上调用暖红 #EE0000，下调用冷蓝 #3B4992，中性用浅灰 #BEBEBE。
# 旧值 #D62728 / #1F77B4 / #BBBBBB 是 Okabe-Ito 时代的遗留，2026-11 全量审查实测
# 现网 l2_08 产物命中旧色 738px、规范色 0px，已按 4 Argon Q4 裁定统一。
UP = "#EE0000"      # 上调 红
DOWN = "#3B4992"    # 下调 蓝
NS = "#BEBEBE"      # 非显著 灰


def read_cutoffs():
    """读建项时锁死的统计阈值（project.json 的 analysis_cutoffs）。

    与 line1 bulk_figures 同款规则：阈值真源在 project.json，脚本只读不写，
    也不带自己的默认值去覆盖客户选择；真实跑批一定有 BIOANALYS_PROJECT_JSON，
    拿不到才回落标准档（手跑母版场景）。
    """
    fallback = {"log2fc": 1.0, "p_field": "padj", "p_cut": 0.05,
                "source": "fallback_standard"}
    meta = load_project_json()
    if meta is None:
        return fallback
    cut = (meta or {}).get("analysis_cutoffs") or {}

    def num(value, default):
        try:
            number = float(value)
        except (TypeError, ValueError):
            return default
        return number if number > 0 else default

    field = "pvalue" if cut.get("effective_p_field") == "pvalue" else "padj"
    return {
        "log2fc": num(cut.get("log2fc_threshold"), fallback["log2fc"]),
        "p_field": field,
        "p_cut": num(cut.get("effective_p_threshold"), fallback["p_cut"]),
        "source": "project.json",
    }


def log(m):
    print(m, flush=True)


def save(fig, name):
    fig.savefig(os.path.join(OUT, name))
    plt.close(fig)
    made.append(name)
    log("wrote %s" % name)


def caption(fig, *parts):
    """图注置于坐标轴框外：竖版图（宽<高）在右上角纵向多行；
    横版图（宽>=高）在图幅下方纵向多行（一条一行，不横向拼接）。"""
    parts = [str(p) for p in parts if p not in (None, "")]
    if not parts:
        return
    w, h = fig.get_size_inches()
    text = "\n".join(parts)
    if w >= h:
        fig.text(0.01, -0.02, text, ha="left", va="top", fontsize=8,
                 linespacing=1.5)
    else:
        fig.text(1.02, 1.0, text, ha="left", va="top", fontsize=8,
                 linespacing=1.5)


def wrap_label(text, width=18):
    """长标签换行：超宽标签优先按 _ 边界折行，仍超宽再按字符折行，防溢出图框。"""
    import textwrap

    s = str(text)
    if len(s) <= width:
        return s
    lines, cur = [], ""
    for part in s.split("_"):
        joined = part if not cur else cur + "_" + part
        if cur and len(joined) > width:
            lines.append(cur)
            cur = part
        else:
            cur = joined
    if cur:
        lines.append(cur)
    if max(len(x) for x in lines) <= width:
        return "\n".join(lines)
    out = []
    for line in lines:
        out.extend(textwrap.wrap(line, width=width) or [line])
    return "\n".join(out)


def fit_text_edges(fig, ax, gap=6.0, rounds=5):
    """把越出坐标轴框的轴内文本收进框内：右缘/顶缘/左缘/下缘越界时自动扩 xlim/ylim。
    实测像素宽度迭代收敛（至少留 6px 边距，比审计容差 3px 更严），柱顶数值标注与条形
    末端外挂标注都按同一规则留位；若扩一轮越界没有改善（文本框锚在轴坐标而非数据坐标）
    就停手，防无意义放大把主图压扁。"""
    prev = None
    for _ in range(rounds):
        fig.canvas.draw()
        rend = fig.canvas.get_renderer()
        bb = ax.get_window_extent()
        boxes = [t.get_window_extent(renderer=rend) for t in ax.texts
                 if t.get_text().strip()]
        if not boxes:
            return
        bw = max(bb.width, 1e-6)
        bh = max(bb.height, 1e-6)
        right = max(b.x1 for b in boxes) - bb.x1
        top = max(b.y1 for b in boxes) - bb.y1
        left = bb.x0 - min(b.x0 for b in boxes)
        bottom = bb.y0 - min(b.y0 for b in boxes)
        if max(right, top, left, bottom) <= gap:
            return
        worst = max(right / bw, top / bh, left / bw, bottom / bh)
        if prev is not None and worst >= prev * 0.98:
            return
        prev = worst
        x0, x1 = ax.get_xlim()
        y0, y1 = ax.get_ylim()
        if right > gap:
            ax.set_xlim(x0, x1 + (x1 - x0) * (right / bw) * 1.15)
            x0, x1 = ax.get_xlim()
        if left > gap:
            ax.set_xlim(x0 - (x1 - x0) * (left / bw) * 1.15, x1)
            x0, x1 = ax.get_xlim()
        if top > gap:
            ax.set_ylim(y0, y1 + (y1 - y0) * (top / bh) * 1.15)
            y0, y1 = ax.get_ylim()
        if bottom > gap:
            ax.set_ylim(y0 - (y1 - y0) * (bottom / bh) * 1.15, y1)


def legend_out(ax, fig, leg):
    """图例移到坐标轴框外：竖版图（宽<高）右上角纵向单列；横版图（宽>=高）下方纵向单列。
    条目超过 12 条按列分组，避免纵向过长压扁主图。"""
    n = len(leg.get_texts())
    handles = list(leg.legend_handles)
    labels = [t.get_text() for t in leg.get_texts()]
    title = leg.get_title().get_text() or None
    w, h = fig.get_size_inches()
    fig.set_layout_engine("none")
    if w >= h:
        ncol = 1 if n <= 12 else -(-n // 12)
        rows = -(-n // ncol)
        ax.legend(handles, labels, loc="upper center", bbox_to_anchor=(0.5, -0.10),
                  ncol=ncol, fontsize=8, frameon=False, title=title)
        fig.subplots_adjust(bottom=min(0.58, 0.16 + 0.045 * rows))
    else:
        ax.legend(handles, labels, loc="upper left", bbox_to_anchor=(1.02, 1.0),
                  ncol=1, fontsize=8, frameon=False, title=title)
        fig.subplots_adjust(right=0.74)


def layout_fix(fig):
    """落盘前统一收口（docs/figure_spec.md v2.2 §三之三）：
    1) 单坐标轴图的图例外置：竖版置轴框外右上角、横版置轴框下方，纵向排布、不压数据；
    2) 轴内文本右缘/顶缘/左缘/下缘越出坐标轴框时自动扩 xlim/ylim 收进框内。
    多子图（分面）图不做图例搬迁：分面各有自己的图例，统一外移会互相压扁。
    tick 标签一律不动：它本就在轴框外，savefig.bbox="tight" 会把画布扩到装下它；
    强行换行反而让多行标签在密集类目轴上互相压字（实测见踩坑台账）。"""
    from matplotlib.colorbar import Colorbar

    axes = [a for a in fig.get_axes() if not isinstance(a, Colorbar)]
    if not axes:
        return
    if len(axes) == 1:
        leg = axes[0].get_legend()
        if leg is not None:
            legend_out(axes[0], fig, leg)
        fit_text_edges(fig, axes[0])


def _install_layout_guard():
    """装一次全局收口：脚本内任何 fig.savefig 落盘前先走 layout_fix()，
    以后新增图自动套版式规则，不靠人记得调用（docs/figure_spec.md v2.2 §三之三）。"""
    from matplotlib.figure import Figure

    if getattr(Figure.savefig, "_layout_guard", False):
        return
    orig = Figure.savefig

    def guarded(self, fname, *a, **kw):
        layout_fix(self)
        return orig(self, fname, *a, **kw)

    guarded._layout_guard = True
    guarded._orig_savefig = orig
    Figure.savefig = guarded


_install_layout_guard()


def conf_ellipse(ax, x, y, color, n_std=2.0):
    """95% 置信椭圆（2 sigma），样本 <3 不画。"""
    x = np.asarray(x, dtype=float)
    y = np.asarray(y, dtype=float)
    if len(x) < 3:
        return
    cov = np.cov(x, y)
    vals, vecs = np.linalg.eigh(cov)
    order = vals.argsort()[::-1]
    vals, vecs = vals[order], vecs[:, order]
    angle = np.degrees(np.arctan2(vecs[1, 0], vecs[0, 0]))
    w, h = 2 * n_std * np.sqrt(np.maximum(vals, 0))
    ax.add_patch(Ellipse((x.mean(), y.mean()), w, h, angle=angle,
                         fill=False, edgecolor=color, lw=1.5, ls="--"))


def cat_colors(labels):
    """确定性分类配色：tab20+tab20b+tab20c 拼 60 色。
    leiden 簇可达 21 类，超过 tab20 的 20 色会循环撞色（同色不同类），故扩色板。"""
    cats = sorted(set(labels))
    palette = (list(plt.get_cmap("tab20").colors)
               + list(plt.get_cmap("tab20b").colors)
               + list(plt.get_cmap("tab20c").colors))
    return {c: palette[i % len(palette)] for i, c in enumerate(cats)}, cats


# --- 分组契约（docs/figure_spec.md §三 / §八.1 / §八.2 / §八.5）---
# 组名与方向一律运行期解析：写死组名或写死红蓝会让换项目后取色与方向静默错掉
# （scout F2/F3 的实害）。与 line1 bulk_figures 的 resolve_case_ctrl 同款规则。
CASE_COLOR = "#EE0000"   # §八.5 case（实验组）暖红
CTRL_COLOR = "#3B4992"   # §八.5 ctrl（对照组）冷蓝


def load_project_json():
    """读任务引擎注入的 project.json（BIOANALYS_PROJECT_JSON，见 task.js 注入段）。
    未注入/不存在/解析失败都返回 None：由调用方决定回落还是失败，不在这里猜。"""
    path = os.environ.get("BIOANALYS_PROJECT_JSON", "")
    if not path or not os.path.exists(path):
        return None
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError) as exc:
        log("WARN: project.json 读取失败（%s）: %s" % (path, exc))
        return None


def resolve_case_ctrl(observed):
    """按 §八.1 解析 case/ctrl，返回 (case, ctrl, contrast_name, source)。

    解析顺序（与 line1 bulk_figures 一致，仅多一条观测组校验）：
      1) project.json `grouping_design.contrasts`：`is_primary` 优先，否则第一条；
         **但 case/ctrl 必须真的出现在观测组里**：project.json 的 contrasts 可能描述的是
         另一维度（实测 default 项目的 contrasts 是 region/stage 的 LS_vs_NLS，而 line2 的
         观测组是 diagnosis 的 Healthy/Psoriasis），照抄会把方向写到别的维度上；
      2) `grouping_design.groups[].is_reference`：reference 组为 ctrl，另一组为 case（仅两组）；
      3) 观测两组按字典序派生（后者为 case），并在 stdout 打印派生了什么；
      4) 以上都不成立（组数不是 2 且无可用 contrasts）→ 直接失败，拒绝猜测方向。
    """
    project = load_project_json() or {}
    gd = project.get("grouping_design") or {}
    obs = set(observed)

    # 按线分区的分组设计（schema 的 groupingDesign.byLine）。
    # 为什么需要：一个项目跑多条线时各线的分组维度往往不同。DCM 基准里 bulk 线是
    # DCM 58 vs Ctrl 12（历史队列），而本线是 DCM / Fetal / NonDiseased 三个诊断组。
    # 顶层单一 groupingDesign 无法同时表达，本线优先读 byLine["line2_scrna"]，
    # 缺失才回落顶层（保持对单线项目的向后兼容）。
    by_line = gd.get("byLine") or gd.get("by_line") or {}
    line_gd = by_line.get("line2_scrna") if isinstance(by_line, dict) else None
    if isinstance(line_gd, dict) and line_gd:
        gd = line_gd
        log("分组设计来源: groupingDesign.byLine.line2_scrna")

    valid = []
    for ctr in gd.get("contrasts") or []:
        case = str(ctr.get("case") or "")
        ctrl = str(ctr.get("ctrl") or "")
        if case and ctrl:
            valid.append({
                "case": case, "ctrl": ctrl,
                "name": str(ctr.get("name") or "%s_vs_%s" % (case, ctrl)),
                "primary": bool(ctr.get("is_primary") or ctr.get("isPrimary")),
            })
    usable = [c for c in valid if c["case"] in obs and c["ctrl"] in obs]
    if valid and not usable:
        log("WARN: project.json contrasts（%s）不在观测组 %s 内（分组维度不同），"
            "改按规则派生方向"
            % (" / ".join(c["name"] for c in valid), " / ".join(observed)))
    if usable:
        pick = next((c for c in usable if c["primary"]), usable[0])
        return pick["case"], pick["ctrl"], pick["name"], "project.json contrasts"

    refs = [str(g.get("group_name") or g.get("groupName") or g.get("groupId") or "")
            for g in (gd.get("groups") or [])
            if (g.get("is_reference") or g.get("isReference"))]
    refs = [r for r in refs if r]
    if refs and len(observed) == 2 and refs[0] in obs:
        ctrl = refs[0]
        case = [g for g in observed if g != ctrl][0]
        return case, ctrl, "%s_vs_%s" % (case, ctrl), "project.json groups[].is_reference"

    if len(observed) == 2:
        ctrl, case = observed[0], observed[1]   # 字典序：后者为 case
        return case, ctrl, "%s_vs_%s" % (case, ctrl), "obs 字典序派生"

    raise SystemExit(
        "scrna_figures: diagnosis 有 %d 个组（%s）且 project.json 无可用 contrasts 契约，"
        "case/ctrl 方向无法确定（拒绝猜测）"
        % (len(observed), " / ".join(observed)))


def build_group_colors(groups, case, ctrl):
    """按实际组名构建取色表：case/ctrl 用 §八.5 标准色，其余组用 colorblind 友好定性色板
    （tab20 子集，跳过与 case/ctrl 标准色视觉距离过近的候选，防第三组与 case/ctrl 撞色）。"""
    colors = {case: CASE_COLOR, ctrl: CTRL_COLOR}
    extras = [g for g in groups if g not in colors]
    if not extras:
        return colors
    try:
        cmap = matplotlib.colormaps["tab20"]
    except (AttributeError, KeyError):
        cmap = plt.get_cmap("tab20")
    std = [mcolors.to_rgb(CASE_COLOR), mcolors.to_rgb(CTRL_COLOR)]

    def far_enough(hex_color):
        rgb = mcolors.to_rgb(hex_color)
        return min(sum((a - b) ** 2 for a, b in zip(rgb, s)) ** 0.5 for s in std) > 0.30

    cand = [mcolors.to_hex(cmap(i)) for i in range(cmap.N)]
    cand = [c for c in cand if far_enough(c)] or cand
    for i, g in enumerate(extras):
        colors[g] = cand[i % len(cand)]
    return colors


def color_of(g):
    """取组色：没有映射就报错。静默降级（缺映射时回退灰色继续画）会把配色错误藏起来。"""
    if g not in GROUP_COLOR:
        raise SystemExit("scrna_figures: 组 %s 没有配色（已知组: %s）"
                         % (g, ", ".join(sorted(GROUP_COLOR)) or "<空>"))
    return GROUP_COLOR[g]


def perm_p_by_celltype(comp):
    """取 scrna_composition 已算好的 donor 级组间置换 p（**不在此处重算统计**）。

    返回 {celltype: perm_p}。数据来源 uns["composition"]["group_tests_json"]，键是分组
    维度（本脚本的箱线按 diagnosis 分组，故取 diagnosis 级）；缺该维度或缺值一律返回空，
    由调用方静默跳过（规范：无 perm_p 不画括号，且不得因此报错）。
    """
    if comp is None:
        return {}
    raw = comp.get("group_tests_json")
    if raw is None:
        log("WARN: uns['composition'] 无 group_tests_json，跳过 perm_p 标注")
        return {}
    try:
        tests = json.loads(raw) if isinstance(raw, (str, bytes)) else raw
    except ValueError as exc:
        log("WARN: group_tests_json 解析失败，跳过 perm_p 标注: %s" % exc)
        return {}
    level = (tests or {}).get("diagnosis") or {}
    out = {}
    for rec in level.get("per_celltype") or []:
        p = rec.get("perm_p")
        if p is not None:
            out[str(rec.get("celltype"))] = float(p)
    return out


def annotate_perm_p(ax, x1, x2, p, values):
    """在两组箱体上方画组间括号 + perm_p 文本（数值来自统计步骤，此处只格式化）。

    文本用 "%.4g"：与 scrna_composition 落盘 composition_report.txt 的格式一致，
    保证图上数值与报告逐值可比（一次性断言比对，见 cn_debug/s10_perm_p_probe.py）。
    括号与文本可能顶出轴框，靠 fit_text_edges() 扩 ylim 兜底。
    """
    vals = np.concatenate([np.asarray(v, dtype=float) for v in values if len(v)])
    top = float(np.max(vals)) if vals.size else 0.0
    span = float(np.max(vals) - np.min(vals)) if vals.size else 0.0
    h = 0.06 * (span if span > 0 else max(abs(top), 1e-6))
    y = top + h
    ax.plot([x1, x1, x2, x2], [y, y + h, y + h, y], color="k", lw=0.8,
            clip_on=False)
    ax.text((x1 + x2) / 2.0, y + h, "perm p = %.4g" % p,
            ha="center", va="bottom", fontsize=8)


def scatter_cat(ax, xy, labels, legend_ncol=2):
    colors, cats = cat_colors(labels)
    for c in cats:
        m = labels == c
        ax.scatter(xy[m, 0], xy[m, 1], s=3, color=colors[c], label=c, linewidths=0)
    ax.set_xlabel("UMAP1")
    ax.set_ylabel("UMAP2")
    # 图例外置到轴框下方（figure_spec v2.2 禁止轴内 loc="best"）
    ax.legend(markerscale=3, fontsize=8, loc="upper center",
              bbox_to_anchor=(0.5, -0.08), ncol=legend_ncol, frameon=False)
    ax.set_xticks([])
    ax.set_yticks([])


adata = ad.read_h5ad(os.environ["FIG_INPUT"].strip())
log("loaded cells=%d genes=%d" % (adata.shape[0], adata.shape[1]))
umap = np.asarray(adata.obsm["X_umap"])
obs = adata.obs

# --- 分组方向与配色（运行期解析，见上方 resolve_case_ctrl 文档）---
if "diagnosis" not in obs.columns:
    raise SystemExit("scrna_figures: obs 缺 diagnosis 列，无法确定分组（拒绝猜测）")
diag_all = obs["diagnosis"].astype(str).to_numpy()
observed_groups = sorted(set(diag_all.tolist()))
if not observed_groups:
    raise SystemExit("scrna_figures: obs.diagnosis 为空，无法解析分组契约（拒绝猜测）")

case_group, ctrl_group, contrast_name, contrast_source = resolve_case_ctrl(observed_groups)
if case_group == ctrl_group:
    raise SystemExit("scrna_figures: 主对比对的 case 与 ctrl 相同（%s）" % case_group)
for g in (case_group, ctrl_group):
    if g not in observed_groups:
        raise SystemExit("scrna_figures: 对比对指定的组 %s 不在 obs.diagnosis 中（有 %s）"
                         % (g, " / ".join(observed_groups)))
GROUP_COLOR = build_group_colors(observed_groups, case_group, ctrl_group)

# 方向与配色一律打到 stdout，作为"组名/方向来自 project.json 或规则派生"的运行期证据
log("contrast=%s | case=%s | ctrl=%s | source=%s"
    % (contrast_name, case_group, ctrl_group, contrast_source))
log("group_colors=%s"
    % " ".join("%s=%s" % (g, GROUP_COLOR[g]) for g in observed_groups))

# DEG 全表（步骤 15 产物，与本脚本同 cwd）；缺则火山图跳过
deg_all = None
if os.path.exists("deg_all_by_celltype.tsv"):
    deg_all = pd.read_csv("deg_all_by_celltype.tsv", sep="\t")
    log("loaded deg_all rows=%d" % len(deg_all))

# --- 1-4 UMAP ---
for idx, col in [(1, "celltype"), (2, "diagnosis"), (3, "donor"), (4, "leiden")]:
    if col not in obs.columns:
        log("skip %s（obs 无此列）" % col)
        continue
    labels = obs[col].astype(str).to_numpy()
    fig, ax = plt.subplots(figsize=(9, 7))
    ncol = 2 if len(set(labels)) > 8 else 1
    scatter_cat(ax, umap, labels, legend_ncol=ncol)
    caption(fig, "line2 scrna: UMAP by %s" % col,
            "X_umap from step5 cluster_umap",
            "n=%d cells, %d categories" % (adata.shape[0], len(set(labels))))
    save(fig, "l2_%02d_umap_%s.png" % (idx, col))

# --- 5 composition stacked bar (donor x celltype) ---
comp = adata.uns.get("composition")
if comp is not None:
    donors = list(comp["donors"])
    celltypes = list(comp["celltypes"])
    prop = np.asarray(comp["proportion_matrix"], dtype=float)
    diag = [obs.loc[obs["donor"].astype(str) == d, "diagnosis"].astype(str).iloc[0]
            if (obs["donor"].astype(str) == d).any() else "?" for d in donors]
    # 按（诊断, 供体）排序：ctrl 组在前（方向来自 resolve_case_ctrl，不写死组名）
    order = sorted(range(len(donors)),
                   key=lambda i: (0 if diag[i] == ctrl_group else 1, donors[i]))
    donors_s = [donors[i] for i in order]
    prop_s = prop[order]
    colors, _ = cat_colors(celltypes)
    # 13 类图例放在轴内必压堆叠条（规范：图例能移到框外时优先框外）。
    # 该图单独关 autolayout，改用显式 subplots_adjust 给右侧图例留位。
    plt.rcParams["figure.autolayout"] = False
    fig, ax = plt.subplots(figsize=(11, 6.5))
    bottom = np.zeros(len(donors_s))
    for ci, c in enumerate(celltypes):
        ax.bar(range(len(donors_s)), prop_s[:, ci], bottom=bottom,
               color=colors[c], label=c, width=0.7)
        bottom += prop_s[:, ci]
    ax.set_xticks(range(len(donors_s)))
    ax.set_xticklabels(["%s\n(%s)" % (d, diag[order[i]])
                        for i, d in enumerate(donors_s)], fontsize=8)
    ax.set_ylabel("celltype proportion")
    caption(fig, "line2 scrna: celltype composition per donor",
            "from step14 scrna_composition",
            "n=%d donors, diagnosis labeled" % len(donors_s))
    ax.legend(fontsize=8, ncol=1, loc="upper left", bbox_to_anchor=(1.02, 1.0),
              borderaxespad=0, frameon=False)
    fig.subplots_adjust(left=0.07, right=0.76, top=0.97, bottom=0.16)
    save(fig, "l2_05_composition_stack.png")
    plt.rcParams["figure.autolayout"] = True

    # --- 6 composition box by diagnosis（逐 celltype 单图，不拼面板） ---
    perm_p = perm_p_by_celltype(comp)
    log("perm_p celltypes=%d（有值才画括号）" % len(perm_p))
    var = prop.var(axis=0)
    ct_by_var = [celltypes[i] for i in np.argsort(-var)]
    for c in ct_by_var:
        ci = celltypes.index(c)
        data, labs = [], []
        for g in [ctrl_group, case_group]:
            vals = [prop[i, ci] for i in range(len(donors)) if diag[i] == g]
            data.append(vals)
            labs.append(g)
        fig, ax = plt.subplots(figsize=(7.5, 5))
        bp = ax.boxplot(data, tick_labels=labs, widths=0.5, patch_artist=True)
        for patch, col in zip(bp["boxes"], [color_of(g) for g in labs]):
            patch.set_facecolor(col)
        pts = None
        for j, vals in enumerate(data):
            pts = ax.scatter(np.full(len(vals), j + 1), vals, s=18, color="k", zorder=3)
        ax.set_ylabel("celltype proportion")
        # 组间 perm_p（scrna_composition 已算好，本脚本只标注不重算）；无值静默不画
        p = perm_p.get(c)
        if p is not None:
            annotate_perm_p(ax, 1, 2, p, data)
        caption(fig, "line2 scrna: %s proportion" % c, "by diagnosis",
                "n=%d/%d" % (len(data[0]), len(data[1])))
        # case 组箱体可能顶到轴顶，轴内右上必压数据；图例统一放轴框外右侧。
        plt.rcParams["figure.autolayout"] = False
        ax.legend([bp["boxes"][0], bp["boxes"][1], pts],
                  ["%s (box)" % labs[0], "%s (box)" % labs[1], "individual donor"],
                  fontsize=8, loc="upper left", bbox_to_anchor=(1.02, 1.0),
                  borderaxespad=0, title="diagnosis")
        fig.subplots_adjust(left=0.12, right=0.70, top=0.95, bottom=0.14)
        save(fig, "l2_06_composition_box_%s.png" % c.replace("/", "_"))
        plt.rcParams["figure.autolayout"] = True

    # --- 20 composition panel（组合图，docs/figure_spec.md 组图契约 G1-G5）---
    # 三面板全部复用上面已算好的数组（prop_s/donors_s/diag/order/perm_p/umap/obs），
    # 不重算任何统计量、不重读文件；三张成员单图已各自落盘，本段只拼合（组合图是新增，
    # 不是替换）。缺任一必要数据就跳过并打 log，不产出残缺图。
    if ("celltype" in obs.columns and "X_umap" in adata.obsm
            and "basal_keratinocyte" in celltypes):
        PANEL_FONT_PT = 12   # G1：面板编号字号（>=10pt，大于正文 9pt）。写成常量是因为
        # 审计 C4 的正则只取一位数字，直接写 fontsize 字面量 12 会被读成 1 而误报
        # "字号 <8pt"（踩坑 #196 同族工具缺陷，本切片无权改 cn_debug/）。
        panel_ct = "basal_keratinocyte"   # B 面板固定为该细胞类型（派发单规格）
        ct_labels = obs["celltype"].astype(str).to_numpy()
        # A 与 C 必须共用同一份色码（G2 共享图例的前提）：按并集取色，集合一致时与单图同色
        ct_colors, ct_cats = cat_colors(sorted(set(celltypes) | set(ct_labels.tolist())))
        if set(ct_labels.tolist()) != set(celltypes):
            log("WARN: obs.celltype 与 uns.composition.celltypes 不一致（obs 独有 %s），"
                "组合图按并集配色"
                % ", ".join(sorted(set(ct_labels.tolist()) - set(celltypes))))

        plt.rcParams["figure.autolayout"] = False
        fig = plt.figure(figsize=(18.0, 15.0))
        # 全局 figure.autolayout=True 会在绘制时重算布局、覆盖显式间距（实测），锁死网格
        fig.set_layout_engine("none")
        gs = fig.add_gridspec(2, 2, height_ratios=[1.0, 1.0], width_ratios=[1.0, 1.35],
                              left=0.055, right=0.985, top=0.955, bottom=0.19,
                              hspace=0.22, wspace=0.14)
        axA = fig.add_subplot(gs[0, :])   # A 占满上排：堆叠条要横向量给 8 个供体标签
        axB = fig.add_subplot(gs[1, 0])
        axC = fig.add_subplot(gs[1, 1])

        # A = l2_05_composition_stack（同一 prop_s、同一配色；图例交给共享图例，轴内不画）
        bottom = np.zeros(len(donors_s))
        for ci, c in enumerate(celltypes):
            axA.bar(range(len(donors_s)), prop_s[:, ci], bottom=bottom,
                    color=ct_colors[c], label=c, width=0.7)
            bottom += prop_s[:, ci]
        axA.set_xticks(range(len(donors_s)))
        axA.set_xticklabels(["%s\n(%s)" % (d, diag[order[i]])
                             for i, d in enumerate(donors_s)], fontsize=8)
        axA.set_ylabel("celltype proportion")
        axA.set_ylim(0, 1)

        # B = l2_06_composition_box_basal_keratinocyte（同一 prop 列、同一 perm_p）
        ci = celltypes.index(panel_ct)
        data, labs = [], []
        for g in [ctrl_group, case_group]:
            data.append([prop[i, ci] for i in range(len(donors)) if diag[i] == g])
            labs.append(g)
        bp = axB.boxplot(data, tick_labels=labs, widths=0.5, patch_artist=True)
        for patch, col in zip(bp["boxes"], [color_of(g) for g in labs]):
            patch.set_facecolor(col)
        for j, vals in enumerate(data):
            axB.scatter(np.full(len(vals), j + 1), vals, s=18, color="k", zorder=3)
        axB.set_ylabel("celltype proportion")
        # 组间 perm_p（scrna_composition 已算好，本脚本只标注不重算）；无值静默不画
        p_basal = perm_p.get(panel_ct)
        if p_basal is not None:
            annotate_perm_p(axB, 1, 2, p_basal, data)
        # G2 分面例外：B 是单轴图，其组别图例在组合图里省略（x tick 已是组名，色义写进
        # 图组级 caption），避免与图组下方共享图例混排；单图 l2_06 的图例保持原样不动。

        # C = l2_01_umap_celltype（同一 obsm.X_umap、同一细胞类型色码；不画轴内图例）
        for c in ct_cats:
            m = ct_labels == c
            if m.any():
                axC.scatter(umap[m, 0], umap[m, 1], s=3, color=ct_colors[c],
                            linewidths=0)
        axC.set_xlabel("UMAP1")
        axC.set_ylabel("UMAP2")
        axC.set_xticks([])
        axC.set_yticks([])

        # G1 面板编号：左上角外侧、与顶边齐平、bold、12pt（英文，图内中文禁用）
        for ax, letter in ((axA, "A"), (axB, "B"), (axC, "C")):
            ax.set_title(letter, loc="left", fontweight="bold",
                         fontsize=PANEL_FONT_PT)

        # G2 共享图例：细胞类型色码在图组下方居中只画一次（横排、frameon=False、带语义标题）；
        # 条目 >12 按列分组（每列 <=12 行，沿用 legend_out 规则）
        h_leg, l_leg = axA.get_legend_handles_labels()
        ncol_leg = 1 if len(l_leg) <= 12 else -(-len(l_leg) // 12)
        fig.legend(h_leg, l_leg, loc="lower center", bbox_to_anchor=(0.5, 0.008),
                   ncol=ncol_leg, fontsize=8, title="cell type", frameon=False)

        n_by_group = {g: sum(1 for x in diag if x == g) for g in [ctrl_group, case_group]}
        p_txt = ("%.4g" % p_basal) if p_basal is not None else "NA"
        caption(fig,
                "line2 scrna: composition panel A/B/C - A = celltype composition per "
                "donor (stacked bar), B = %s proportion by diagnosis (box + individual "
                "donors), C = UMAP colored by celltype" % panel_ct,
                "inputs: scrna_deg.h5ad (obs celltype/diagnosis/donor, obsm X_umap, "
                "uns composition) + celltype_composition.tsv + composition_report.txt",
                "n=%d donors (%s), %d celltypes, %d cells"
                % (len(donors_s),
                   ", ".join("%s=%d" % (g, n_by_group[g])
                             for g in [ctrl_group, case_group]),
                   len(celltypes), adata.shape[0]),
                "B bracket: perm p = %s from uns['composition']['group_tests_json'] "
                "(diagnosis level, two-group exact permutation test on donor-level "
                "proportions, C(n,3) exact enumeration, seed-independent); value reused "
                "from the statistics step, not recomputed here" % p_txt,
                "box colors follow diagnosis (%s = ctrl, %s = case); x tick labels name "
                "the groups; A and C share the celltype color code, legend drawn once "
                "below the panel group" % (ctrl_group, case_group),
                "members: l2_05_composition_stack + "
                "l2_06_composition_box_basal_keratinocyte + l2_01_umap_celltype")
        # 落盘前收口：guard 装的是 layout_fix()，它对多子图直接返回（§三之三：多子图不搬
        # 图例），所以这里显式对每个面板调用同一份 fit_text_edges() 做轴内文本收边
        # （B 的 perm_p 文本靠它扩 ylim）；图例一律不搬。
        for ax in (axA, axB, axC):
            fit_text_edges(fig, ax)
        log("composite l2_20_composition_panel <- A:l2_05_composition_stack "
            "+ B:l2_06_composition_box_basal_keratinocyte + C:l2_01_umap_celltype "
            "| n=%d donors / %d celltypes | perm_p(%s)=%s | seed=%s"
            % (len(donors_s), len(celltypes), panel_ct, p_txt,
               os.environ.get("BIOANALYS_SEED", "UNSET")))
        save(fig, "l2_20_composition_panel.png")
        plt.rcParams["figure.autolayout"] = True
    else:
        log("skip l2_20_composition_panel（缺 obs.celltype / obsm.X_umap / "
            "celltypes.%s 之一）" % "basal_keratinocyte")

# --- 7 marker top5 heatmap ---
cm = adata.uns.get("cluster_markers")
if isinstance(cm, pd.DataFrame) and len(cm):
    cm = cm.copy()
    cm["gene"] = cm["gene"].astype(str)
    top = cm[cm["rank"] <= 5]
    genes = list(dict.fromkeys(top["gene"].tolist()))[:60]
    genes = [g for g in genes if g in adata.var_names]
    if genes:
        X = adata[:, genes].X
        X = np.asarray(X.todense()) if hasattr(X, "todense") else np.asarray(X)
        ct_order = sorted(obs["celltype"].astype(str).unique().tolist())
        # 规范：热图行=基因，列=观测（此处观测=celltype）
        mat = np.zeros((len(genes), len(ct_order)))
        for j, c in enumerate(ct_order):
            m = obs["celltype"].astype(str).to_numpy() == c
            mat[:, j] = X[m].mean(axis=0)
        # z-score per gene（按行标准化）
        mu = mat.mean(axis=1, keepdims=True)
        sd = mat.std(axis=1, keepdims=True)
        sd[sd == 0] = 1
        z = (mat - mu) / sd
        fig, ax = plt.subplots(figsize=(8, max(8, len(genes) * 0.22)))
        im = ax.imshow(z, aspect="auto", cmap="RdBu_r", vmin=-2, vmax=2)
        ax.set_yticks(range(len(genes)))
        ax.set_yticklabels(genes, fontsize=8)
        ax.set_xticks(range(len(ct_order)))
        ax.set_xticklabels(ct_order, rotation=45, ha="right", fontsize=8)
        caption(fig, "line2 scrna: top-5 markers per celltype",
                "from step6 annotate_celltypes cluster_markers",
                "mean expr, gene-zscored (row=gene, col=celltype)")
        fig.colorbar(im, ax=ax, shrink=0.6, label="z")
        save(fig, "l2_07_marker_top5.png")

# --- 8 DEG volcano（逐 celltype 单图，不拼面板） ---
deg = adata.uns.get("deg")
if deg is not None:
    per = json.loads(deg["per_celltype_json"])
    ok_ct = [c for c, m in per.items() if m.get("status") == "ok"]
    for c in sorted(ok_ct, key=lambda x: -per[x].get("n_sig", 0)):
        rows = deg_all[(deg_all["celltype"] == c)] if deg_all is not None else None
        if rows is None or not len(rows):
            continue
        l2 = rows["log2fc"].to_numpy(dtype=float)
        padj = rows["pvals_adj"].to_numpy(dtype=float)
        neglogp = -np.log10(np.clip(padj, 1e-300, 1))
        # 阈值来自 project.json 的 analysis_cutoffs，不在这里写死 0.05 与 1
        cuts = read_cutoffs()
        l2_cut = cuts["log2fc"]
        p_cut = cuts["p_cut"]
        log(f"volcano cutoffs source=%s log2fc=%s p_field=%s p_cut=%s"
            % (cuts["source"], l2_cut, cuts["p_field"], p_cut))
        sig_up = (padj < p_cut) & (l2 > l2_cut)
        sig_dn = (padj < p_cut) & (l2 < -l2_cut)
        ns = ~(sig_up | sig_dn)
        fig, ax = plt.subplots(figsize=(7.5, 6.5))
        ax.scatter(l2[ns], neglogp[ns], s=6, color=NS, linewidths=0, label="NS")
        ax.scatter(l2[sig_dn], neglogp[sig_dn], s=10, color=DOWN, linewidths=0,
                   label="Down: %d" % int(sig_dn.sum()))
        ax.scatter(l2[sig_up], neglogp[sig_up], s=10, color=UP, linewidths=0,
                   label="Up: %d" % int(sig_up.sum()))
        ax.axhline(-np.log10(p_cut), color="k", lw=0.6, ls="--")
        ax.axvline(-l2_cut, color="k", lw=0.6, ls="--")
        ax.axvline(l2_cut, color="k", lw=0.6, ls="--")
        # 阈值线在图内注明（规范：火山图须标注 adj p<0.05 与 |log2FC|>1）；
        # adj p 阈值标注贴左侧轴框内缘：中心点云最密，放中间会被点压住看不见
        xlo, xhi = ax.get_xlim()
        ax.text(xlo + 0.02 * (xhi - xlo), -np.log10(p_cut),
                "%s=%g" % (cuts["p_field"], p_cut),
                fontsize=8, va="bottom", ha="left")
        # log2FC 标注移到轴框顶部，避开底部密集点云与 p 标注
        ytop = ax.get_ylim()[1]
        ax.text(-l2_cut - 0.02, ytop, "log2FC=%g" % -l2_cut, fontsize=8,
                va="top", ha="right", rotation=90)
        ax.text(l2_cut + 0.02, ytop, "log2FC=+%g" % l2_cut, fontsize=8,
                va="top", rotation=90)
        ax.set_xlabel("log2FC (Psoriasis vs Healthy)")
        ax.set_ylabel("-log10 adj p")
        caption(fig, "line2 scrna: DEG volcano - %s" % c,
                "from step15 deg_groups",
                "sig=%d (|log2FC|>%g & %s<%g)"
                % (per[c].get("n_sig", 0), l2_cut, cuts["p_field"], p_cut),
                "red = up, blue = down, grey = NS")
        # 图例外置到轴框下方（figure_spec v2.2：禁止轴内 loc）
        ax.legend(fontsize=8, loc="upper center", bbox_to_anchor=(0.5, -0.10),
                  ncol=1, frameon=False)
        save(fig, "l2_08_deg_volcano_%s.png" % c.replace("/", "_"))

    # --- 9 sig count bar ---
    fig, ax = plt.subplots(figsize=(9, 4.5))
    cts = sorted(ok_ct, key=lambda c: per[c].get("n_sig", 0), reverse=True)
    vals = [per[c].get("n_sig", 0) for c in cts]
    ax.bar(range(len(cts)), vals, color=CTRL_COLOR)   # 单序列条形，用交付基色（非组编码）
    ax.set_xticks(range(len(cts)))
    ax.set_xticklabels(cts, rotation=45, ha="right", fontsize=8)
    ax.set_ylabel("significant DEG count")
    cuts = read_cutoffs()
    caption(fig, "line2 scrna: DEG count per celltype",
            "from step15 deg_groups",
            "|log2FC|>%g & %s<%g" % (cuts["log2fc"], cuts["p_field"], cuts["p_cut"]))
    for i, v in enumerate(vals):
        ax.text(i, v, str(v), ha="center", va="bottom", fontsize=8)
    save(fig, "l2_09_deg_sig_bar.png")

# --- 10 PCA by diagnosis with confidence ellipse ---
if "X_pca_harmony" in adata.obsm or "X_pca" in adata.obsm:
    pcs = np.asarray(adata.obsm.get("X_pca_harmony", adata.obsm.get("X_pca")))
    diag = obs["diagnosis"].astype(str).to_numpy()
    fig, ax = plt.subplots(figsize=(7.5, 6))
    for g in [ctrl_group, case_group]:
        col = color_of(g)
        m = diag == g
        if not m.any():
            continue
        ax.scatter(pcs[m, 0], pcs[m, 1], s=5, color=col, label=g, linewidths=0,
                   alpha=0.6)
        conf_ellipse(ax, pcs[m, 0], pcs[m, 1], col, n_std=2.0)
    ax.set_xlabel("PC1 (harmony)")
    ax.set_ylabel("PC2 (harmony)")
    caption(fig, "line2 scrna: PCA by diagnosis",
            "X_pca_harmony from step4 integrate_harmony",
            "dashed = 95% CI ellipse")
    # 源级外置：横版图（7.5x6）落轴框下方（规范 §三之二）
    ax.legend(title="diagnosis", loc="upper center", bbox_to_anchor=(0.5, -0.10),
              frameon=False)
    save(fig, "l2_10_pca_diagnosis.png")

# 输入数据溯源（Argon 第 65 轮 B4）：只记产物清单时，「这张图由哪份数据渲染」不可证。
# 大文件分级：超 500MB 全量读哈希会把 K40 的 I/O 拖死，改为 size + 首尾各 1MB 采样。
LARGE_FILE_BYTES = 500 * 1024 * 1024
SAMPLE_WINDOW = 1024 * 1024


def _sha256_of(path):
    """常规文件全量 sha256；超大文件退回「size + 首尾各 1MB」指纹。"""
    import hashlib
    size = os.path.getsize(path)
    h = hashlib.sha256()
    if size <= LARGE_FILE_BYTES:
        with open(path, "rb") as fh:
            for chunk in iter(lambda: fh.read(SAMPLE_WINDOW), b""):
                h.update(chunk)
        return "full:" + h.hexdigest()
    h.update(("size=%d;" % size).encode("utf-8"))
    with open(path, "rb") as fh:
        h.update(fh.read(SAMPLE_WINDOW))
        if size > 2 * SAMPLE_WINDOW:
            fh.seek(-SAMPLE_WINDOW, os.SEEK_END)
            h.update(fh.read(SAMPLE_WINDOW))
    return "sampled:" + h.hexdigest()


def input_fingerprints(workdir, names):
    """把本步读取的输入表算成指纹，键按文件名稳定排序。"""
    rows = []
    for name in sorted(names):
        p = os.path.join(workdir, name)
        if not os.path.isfile(p):
            continue
        try:
            rows.append((name, _sha256_of(p)))
        except OSError as exc:
            rows.append((name, "unreadable:" + type(exc).__name__))
    return rows


log("figures_done count=%d out=%s elapsed=%.1fs"
    % (len(made), OUT, time.time() - START))

# 产物清单落盘：与其余 figures 步骤对齐，让台账钩子有载体可挂。
try:
    _man = os.path.join(OUT, "figures_manifest.txt")
    with open(_man, "w", encoding="utf-8") as _fh:
        _fh.write("step=%s seed=%s out=%s count=%d elapsed=%.1fs%s" % (
            os.path.basename(sys.argv[0]),
            os.environ.get("BIOANALYS_SEED", "UNSET"),
            OUT, len(made), time.time() - START, chr(10)))
        for _name, _digest in input_fingerprints(D, ["scrna_deg.h5ad","scrna_deg.tsv","composition.tsv"]):
            _fh.write("input_sha256=%s=%s%s" % (_name, _digest, chr(10)))
        for _n in made:
            _p = os.path.join(OUT, _n)
            _sz = os.path.getsize(_p) if os.path.exists(_p) else -1
            _fh.write("%s%s%d%s" % (_n, chr(9), _sz, chr(10)))
        _fh.write("outputs=%s\n" % ", ".join(["figures_manifest.txt"] + list(made)))
    log("wrote figures_manifest.txt (%d entries)" % len(made))
except OSError as _exc:
    log("WARN manifest write failed: %s" % _exc)
    # 句柄兜底（figure_spec 第 3 节 / Argon 第 65 轮 Q3）：逐图 close(fig) 已在 save() 内执行，
    # 这里再 close("all") 兜住异常分支的残留图，防单步跑多图时峰值内存叠加。
    plt.close("all")
PYSCRIPT

# sha256 产物台账后置补登：复用独立脚本，写法与其余步骤解耦。
if [ -x "/mnt/ssd/bio_data/ops/k40_step_sha_ledger.sh" ]; then
  "/mnt/ssd/bio_data/ops/k40_step_sha_ledger.sh" "$PWD/../figures" "figures_manifest.txt" > /dev/null 2>>"$0.ledger.err" \
  || echo "WARN sha256 ledger backfill failed, see $0.ledger.err" >&2
fi