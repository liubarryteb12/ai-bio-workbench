#!/usr/bin/env bash
# 正对照样本：合规写法（rcParams 带 savefig.dpi、fontsize>=8、R png() 带 res=300）
python3 - <<'PYSCRIPT'
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
plt.rcParams.update({"figure.dpi": 300, "savefig.dpi": 300, "font.size": 9})
fig, ax = plt.subplots(figsize=(4, 3))
ax.plot([1, 2], [1, 2])
ax.text(0.5, 0.5, "x", fontsize=8)
fig.savefig("../figures/l1_99_good.png")
plt.close("all")
PYSCRIPT
Rscript - <<'RSCRIPT'
png("out1.png", width = 600, height = 400, res = 300)
plot(1:10)
dev.off()
RSCRIPT
# 合规：bbox_to_anchor 显式外置
fig2, ax2 = plt.subplots(figsize=(4, 3))
ax2.plot([1, 2], [1, 2], label="a")
ax2.legend(bbox_to_anchor=(0.5, -0.10), loc="upper center", frameon=False)
fig2.savefig("../figures/l1_99_good2.png")
plt.close(fig2)
