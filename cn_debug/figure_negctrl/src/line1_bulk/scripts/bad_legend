import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
plt.rcParams.update({"figure.dpi": 300, "savefig.dpi": 300, "font.size": 9})
fig, ax = plt.subplots(figsize=(4, 3))
ax.plot([1, 2], [1, 2], label="a")
ax.plot([2, 3], [2, 3], label="b")
# ① 跨行 loc=：loc 落在 ax.legend( 之后第 3 行（旧 2 行窗口看不见）
ax.legend(
    title = "series",
    loc = "lower right",
    frameon = True
)
# ② 裸 ax.legend()：不写 loc 就是默认 best（轴内）
ax.legend()
fig.savefig("../figures/l1_99_bad_legend.png")
plt.close("all")
