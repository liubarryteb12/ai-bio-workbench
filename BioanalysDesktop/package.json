{
  "name": "bioanalys-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "本地交互层：链路总览 / 任务下发 / 数据面浏览 / 台账巡检。本地零算力，计算全部下沉到手机 Linux 服务器",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "node node_modules/@playwright/test/cli.js test --config playwright.config.ts",
    "delivery:verify": "node ../tools/reporting/delivery_acceptance_core.mjs",
    "test:skip-gate": "node ../tools/dev/skip_reason_gate.mjs",
    "preflight": "node ../tools/dev/preflight.mjs",
    "clean:workspace": "node ../tools/dev/clean_workspace.mjs",
    "delivery:audit": "node ../tools/reporting/audit_summary.mjs",
    "gate:all": "node ../tools/dev/run_all_gates.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.6.3",
    "vite": "5.4.21"
  }
}
