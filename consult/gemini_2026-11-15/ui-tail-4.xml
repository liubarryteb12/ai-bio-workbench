unds="[0,0][1080,2276]" /><node index="1" text="" resource-id="com.google.android.googlequicksearchbox:id/assistant_robin_chat_history_sheet" class="android.widget.FrameLayout" package="com.google.android.googlequicksearchbox" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,2276]"><node index="0" text="" resource-id="com.google.android.googlequicksearchbox:id/assistant_robin_chat_history_list" class="android.support.v7.widget.RecyclerView" package="com.google.android.googlequicksearchbox" content-desc="对话列表" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,2276]"><node index="0" text="" resource-id="com.google.android.googlequicksearchbox:id/assistant_robin_content_message_container" class="android.view.ViewGroup" package="com.google.android.googlequicksearchbox" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,0][1014,2276]"><node index="1" text="" resource-id="com.google.android.googlequicksearchbox:id/assistant_robin_message_content" class="android.support.v7.widget.RecyclerView" package="com.google.android.googlequicksearchbox" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,0][1014,2276]"><node index="5" text="" resource-id="" class="android.widget.HorizontalScrollView" package="com.google.android.googlequicksearchbox" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[66,0][1014,333]"><node index="0" text="运行期事件 探针信号 / 退出码 重试预算状态 工单五态迁移 租约 (leases) 动作 防僵尸 / 防误杀机制&#10;单步 OOM (6.5GB/7.5GB) Exit 137 或 mem_guard 捕获 MEM_LIMIT_EXCEEDED 剩余预算大于 0（adaptation_count &lt; 2） 保持 running 保持持有（心跳继续） 先发 adb shell kill -9 -PGID 清理容器残留进程组，再允许 AI 调 remediate_step_param（如降 worker 至 1）重发 dispatch_step&#10;单步 OOM 预算耗尽 同上 剩余预算等于 0（adaptation_count == 2） running → blocked (failure_stage=mod_id) 同事务释放 (DELETE/EXPIRE) 写入 receipt/v1 (status=blocked, error=OOM_EXHAUSTED)，禁止转为 failed 以免丢失已完成前序步骤缓存，留待人工接管&#10;代码/数据硬错误 Exit 非 0 且非 OOM，且非白名单可调参错误 不消耗自适应预算（不可自愈） running → failed 同事务释放 (DELETE/EXPIRE) 收集 stderr 尾部写入 receipt/v1，执行容器临时目录清理&#10;ADB 瞬时闪断 adb exec-out / forward 10022 Socket 断开 重连窗口内（3 次，间隔 5s/10s/20s） 保持 running 保持持有（本地编排器代维持心跳） 容器内任务由 nohup/setsid 托管写本地 pidfile 与 exitfile；重连成功后先探查 /proc/{pid} 与 exitfile，实现断点续接&#10;ADB 永久失联 3 次重连（共 35s）全部失败 不适用 running → blocked (error=ADB_LOST) 同事务释放 (DELETE/EXPIRE) 标记算力节点 OFFLINE，阻断队列后续工单下发，待设备重插恢复后人工或巡检清理远端孤儿进程&#10;大文件流式回传中 处于 ARCHIVE_PULLING 阶段（10022 端口满载） 正常传输中 保持 running 传输旁路自动续期 只要本地接收流每 10s 内 bytes_received 增量大于 64KB，编排器直接在本地 SQLite 刷新 leases.expires_at = now + 120s，不发 ADB 命令探活，彻底免疫末段带宽饥饿&#10;守护进程崩溃 编排器自身进程挂掉（expires_at &lt; now） 不适用 巡检器扫出超时工单：running → blocked Reaper 强制回收 独立 Watchdog 每 30s 扫描 work_orders.status='running' AND leases.expires_at &lt; now，先尝试 ADB 杀远端进程组，再原子置为 blocked" resource-id="com.google.android.googlequicksearchbox:id/assistant_robin_text" class="android.widget.TextView" package="com.google.android.googlequicksearchbox" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,0][1014,333]" /></node><node index="6" text="风险&#10;​propose_adaptation 触犯 REJ-007（便携包与源码分叉）与 REJ-012（突破 Ready 实证棘轮）的风险：&#10;如果 AI 用 propose_adaptation 生成的补丁脚本非常有效，但只留在单项目的 runs/{project_id}/adaptations/ 里，久而久之线上靠 AI 临时打补丁混过关，而底层 54 个模块母版得不到反哺；反之如果直接自动写回母版，又直接违反 REJ-002/007/012。裁定：propose_adaptation 产出的代码生命周期严格限制在单次 work_order_id 内，随交付包归档备查，严禁自动合入 references_db 或模块母版。&#10;​D2 接收器 .sync_cache 磁盘打满与半包污染：&#10;若 GET /api/sync/package?ticket= 下载中途断流，残留的半截 .tar 会占满桌面端磁盘。裁定：下载必须先写 .sync_cache/{ticket}.tar.part，流式计算 SHA-256 与 claim 返回的 sha256 严格比对一致后，再 rename 为 .tar 并入库 sync_inbox_ledger；不一致立刻 unlink 并重试下载。&#10;​单消费者队列与人工强制接管（Human Preemption）的容器侧踩踏：&#10;当人工在 UI 点击“强制接管”抢走 Lease 时，SQLite 层面毫秒级切换完成，但如果容器内 AI 刚才下发的 R/Python 进程还在跑，人工紧接着下发新指令就会在容器内形成双进程争抢 7.5GB 内存。裁定：人工强制接管 API 在更新 SQLite leases.holder='human' 后，必须同步触发一次 adb shell kill -TERM -{pgid}（2 秒后 -KILL），确保容器算力面净空后再把控制权交给人工。&#10;​下一轮材料&#10;​D4.9 与 D2 的核心接口、状态机与防线已全部锁定。下一轮进入 D0（便携 Electron 桌面壳收尾）与 D1（门户加固） 的架构审查，请提供：&#10;​D0 桌面控制台架构现状：&#10;​Electron 主进程（Main）、渲染进程（Renderer）与本地 Python/Node 编排器后端的通信拓扑（是内置子进程托管、本地 HTTP Loopback，还是纯 IPC？）。&#10;​2 个关键人工交互面（检查点一 180 秒倒计时拦截面板、检查点二报告人工签发与 EXPLORATORY_DEGRADED 探索版签章确认界面）的现有状态流与 API 绑定情况。&#10;​D1 门户（Portal）与 PKG 打包规范：&#10;​门户生成 PKG 提交包的目录结构、Schema 校验规则，以及门户侧如何防止恶意大文件上传或畸形 GSM 映射注入。" resource-id="com.google.android.googlequicksearchbox:id/assistant_robin_text" class="android.widget.TextView" package="com.google.android.googlequicksearchbox" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,443][1014,2276]" /></node></node></node></node><node index="2" text="" resource-id="com.google.android.googlequicksearchbox:id/assistant_chat_history_footer" class="android.view.ViewGroup" package="com.google.android.googlequicksearchbox" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1926][1080,2276]"><node index="0" text="" resource-id="" class="android.view.View" package="com.google.android.googl