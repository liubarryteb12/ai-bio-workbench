{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": [
      "./BioanalysDesktop/node_modules/@types"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/core/**/*.ts",
    "src/engines/**/*.ts",
    "src/mods/**/*.ts"
  ]
}
