{
  "a2a": {
    "server": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 9910,
      "portFallback": 10,
      "agentName": "pi-termux-executor",
      "peerTokens": {
        "codex": "<REDACTED>"
      },
      "trustedPeers": [
        "codex"
      ],
      "allowAllUsers": false,
      "maxConcurrent": 2,
      "replyTimeoutSec": 300,
      "childTranscripts": true,
      "childTranscriptRetentionDays": 7,
      "rateLimitPerMin": 30
    },
    "timeouts": {
      "send": 360000,
      "stream": 120000
    }
  }
}
