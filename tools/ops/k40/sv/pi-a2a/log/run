#!/data/data/com.termux/files/usr/bin/sh
# 日志追加 + 10MB 轮转（只留一份 .log.old）。
# 为什么不用 svlogd：Android 私有存储上 svlogd 的目录锁必定失败（temporary failure），
# 服务会反复 down，log 子服务 crash-loop 正是台账坑 #88 的形态。
LOG="/data/data/com.termux/files/usr/var/log/pi-a2a.log"
MAX_BYTES=10485760
while :; do
  if [ -f "$LOG" ]; then
    size=$(wc -c < "$LOG" 2>/dev/null || echo 0)
    if [ "$size" -gt "$MAX_BYTES" ]; then
      mv -f "$LOG" "$LOG.old" 2>/dev/null || true
    fi
  fi
  cat >> "$LOG"
done
