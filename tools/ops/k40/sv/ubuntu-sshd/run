#!/data/data/com.termux/files/usr/bin/sh
set -eu
exec 2>&1
# tools/ops/k40/sv/ubuntu-sshd/run —— K40 容器面 dropbear 服务定义（四段式模板，2026-11-03 起）
# 落点：k40:$PREFIX/var/service/<service>/{run,log/run}
# 同步：bash tools/ops/k40/ensure_runsvdir.sh 会把本目录镜像到设备并幂等点火。
#
# 四段式约定同 sshd/run：段1 shebang + set -eu，段2 exec 2>&1，段3 幂等守卫，段4 原位替换。
#
# 段3 守卫：dropbear 缺 -r 指向的密钥时打印 No hostkeys available 并退出（实测 exit 1），
# runit 重启循环、10022 永不监听。密钥在容器内，宿主侧按 proot 容器根判断再进容器生成。
PREFIX=/data/data/com.termux/files/usr
export PREFIX
export HOME=/data/data/com.termux/files/home
export PATH="$PREFIX/bin:$PREFIX/bin/applets"
export TMPDIR="$PREFIX/tmp"

ROOTFS="$PREFIX/var/lib/proot-distro/containers/ubuntu/rootfs"
HOST_KEY="$ROOTFS/etc/dropbear/dropbear_ed25519_host_key"
if [ ! -f "$HOST_KEY" ]; then
  echo "[guard:ubuntu-sshd] host key missing -> dropbearkey"
  if ! "$PREFIX/bin/proot-distro" login ubuntu -- \
      /usr/bin/dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key; then
    echo "[guard:ubuntu-sshd] ERR_STAGE_HOSTKEY_10022 dropbearkey 退出码非零，10022 将不可达"
    exit 1
  fi
  [ -f "$HOST_KEY" ] || { echo "[guard:ubuntu-sshd] ERR_STAGE_HOSTKEY_10022 宿主侧仍看不到 $HOST_KEY"; exit 1; }
  echo "[guard:ubuntu-sshd] host key 已重建，指纹变更需同步 known_hosts"
fi

exec "$PREFIX/bin/proot-distro" login ubuntu -- \
  /mnt/ssd/bio_data/bin/dropbear-static-20261027 \
  -F -E -p 10022 -r /etc/dropbear/dropbear_ed25519_host_key -s